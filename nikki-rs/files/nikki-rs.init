#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/clash-rs"
[ ! -x "/etc/nikki-rs/core/clash-rs" ] || PROG="/etc/nikki-rs/core/clash-rs"

. "$IPKG_INSTROOT/etc/nikki-rs/scripts/include.sh"

extra_command 'update_subscription' 'Update subscription by section id'
extra_command 'update_rule_provider' 'Update rule provider by section id'
extra_command 'update_china_mainland_ip' 'Update China Mainland IP list'
extra_command 'update_china_mainland_ip6' 'Update China Mainland IP6 list'
extra_command 'clear_logs' 'Clear logs if size exceeds the limit'
extra_command 'preview_profile' 'Compose an effective profile for a candidate file without starting the service'

boot_func() {
	# prepare files
	prepare_files
	# load config
	config_load nikki-rs
	# check if enabled and boot_start
	local enabled boot_start start_delay
	config_get_bool enabled "config" "enabled" 0
	config_get_bool boot_start "config" "boot_start" 0
	if [ "$enabled" = 0 ] || [ "$boot_start" = 0 ]; then
		# Register config reload triggers without starting a core instance.
		rc_procd :
		log "App" "Boot start disabled."
		log "App" "Exit."
		return
	fi
	# start delay
	config_get start_delay "config" "start_delay" 0
	if [ "$start_delay" -gt 0 ]; then
		log "App" "Start after $start_delay seconds."
		sleep "$start_delay"
	fi
	# start
	start
}

boot() {
	boot_func < /dev/null > /dev/null 2>&1 &
}

# Build the mixin in isolation so failures never publish a partial profile.
mixin_profile() (
	mixin_target="$RUN_PROFILE_PATH"
	mixin_tmpdir=$(mktemp -d "$RUN_DIR/.mixin.XXXXXX") || exit 1
	trap 'rm -rf "$mixin_tmpdir"' EXIT
	cp -f "$mixin_target" "$mixin_tmpdir/config.yaml" || exit 1
	RUN_PROFILE_PATH="$mixin_tmpdir/config.yaml"
	log "Mixin" "Mixin config."
	if [ "$overwrite_authentication" = 1 ]; then
		yq -M -i 'del(.authentication)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_tun_dns_hijack" = 1 ]; then
		yq -M -i 'del(.tun.dns-hijack)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_fake_ip_filter" = 1 ]; then
		yq -M -i 'del(.dns.fake-ip-filter)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_black_filter" = 1 ]; then
		yq -M -i 'del(.dns.black-filter)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_hosts" = 1 ]; then
		yq -M -i 'del(.hosts)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_dns_nameserver" = 1 ]; then
		yq -M -i 'del(.dns.default-nameserver) | del(.dns.proxy-server-nameserver) | del(.dns.direct-nameserver) | del(.dns.nameserver) | del(.dns.fallback) ' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_dns_proxy_server_nameserver" = 1 ]; then
		yq -M -i 'del(.dns.proxy-server-nameserver)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_dns_nameserver_policy" = 1 ]; then
		yq -M -i 'del(.dns.nameserver-policy)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_sniffer_force_domain_name" = 1 ]; then
		yq -M -i 'del(.sniffer.force-domain)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_sniffer_ignore_domain_name" = 1 ]; then
		yq -M -i 'del(.sniffer.skip-domain)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_sniffer_sniff" = 1 ]; then
		yq -M -i 'del(.sniffer.sniff)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_mmdb" = 1 ]; then
		yq -M -i 'del(.mmdb) | del(.mmdb-download-url)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_geosite" = 1 ]; then
		yq -M -i 'del(.geosite) | del(.geosite-download-url)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$overwrite_asn_mmdb" = 1 ]; then
		yq -M -i 'del(.asn-mmdb) | del(.asn-mmdb-download-url)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	if [ "$ui_internal" = 1 ]; then
		yq -M -i 'del(.external-ui) | del(.external-ui-name) | del(.external-ui-url)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
	fi
	yq -M -i 'del(.ebpf)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1

	local mixin_rule_provider; config_get_bool mixin_rule_provider "mixin" "rule_provider" 0
	if [ "$mixin_rule_provider" = 1 ] && [ "${preview_mode:-0}" != 1 ]; then
		config_foreach prepare_rule_provider "rule_provider"
	fi
	ucode -S "$MIXIN_UC" > "$mixin_tmpdir/mixin.json" 2>> "$APP_LOG_PATH" || exit 1
	yq -M -p json -o yaml "$mixin_tmpdir/mixin.json" > "$mixin_tmpdir/mixin.yaml" 2>> "$APP_LOG_PATH" || exit 1
	if [ "$mixin_file_content" = 1 ]; then
		set -- "$RUN_PROFILE_PATH" "$MIXIN_FILE_PATH" "$mixin_tmpdir/mixin.yaml"
	else
		set -- "$RUN_PROFILE_PATH" "$mixin_tmpdir/mixin.yaml"
	fi
	yq -M -i eval-all '... comments="" | . as $item ireduce ({}; . as $acc | ($acc * $item) | .dns2 = ($item.dns2 // $acc.dns2) | ."nikki-proxies" = (($acc."nikki-proxies" // []) + ($item."nikki-proxies" // [])) | ."nikki-proxy-groups" = (($acc."nikki-proxy-groups" // []) + ($item."nikki-proxy-groups" // [])) | ."nikki-rules" = (($acc."nikki-rules" // []) + ($item."nikki-rules" // [])) ) | .proxies = .nikki-proxies + .proxies | del(.nikki-proxies) | .proxy-groups = .nikki-proxy-groups + .proxy-groups | del(.nikki-proxy-groups) | .rules = .nikki-rules + .rules | del(.nikki-rules) | explode(.)' "$@" 2>> "$APP_LOG_PATH" || exit 1
	cp "$RUN_PROFILE_PATH" "$mixin_tmpdir/base.yaml" || exit 1
	NIKKI_EBPF_ENABLED="$ebpf_enabled" "$SH_DIR/override-manager.sh" apply "$RUN_PROFILE_PATH" "$mixin_tmpdir/overridden.yaml" 2>> "$APP_LOG_PATH" || exit 1
	mv -f "$mixin_tmpdir/overridden.yaml" "$RUN_PROFILE_PATH" || exit 1
	if [ "$ebpf_enabled" = 1 ]; then
		log "Mixin" "eBPF is enabled: disabling TUN and removing TUN listeners in the effective profile."
	fi
	if [ "$proxy_enabled" = 1 ] && [ "$ebpf_enabled" != 1 ]; then
		if yq -M -e 'has("tun")' "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
			yq -M -i '(.tun) |= (.auto-route = false | .auto-redirect = false | .auto-detect-interface = false | .disable-icmp-forwarding = true)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
		fi
		if yq -M -e 'has("listeners")' "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
			yq -M -i '(.listeners[] | select(.type == "tun")) |= (.auto-route = false | .auto-redirect = false | .auto-detect-interface = false | .disable-icmp-forwarding = true)' "$RUN_PROFILE_PATH" 2>> "$APP_LOG_PATH" || exit 1
		fi
	fi
	mv -f "$RUN_PROFILE_PATH" "$mixin_target" || exit 1
	mv -f "$mixin_tmpdir/base.yaml" "$RUN_DIR/base.yaml" || exit 1
)

# Compose an effective profile for the LuCI editor's before/after comparison.
# The live run directory, profile, mixin and log are never modified.
preview_profile() {
	local source="$1"
	local output="$2"
	local mixin_override="${3:-}"
	case "$source" in /etc/nikki-rs/*|/tmp/nikki-rs-edit.*) ;; *) return 1 ;; esac
	case "$output" in /tmp/nikki-rs-*|/var/run/nikki-rs/*) ;; *) return 1 ;; esac
	[ -f "$source" ] && [ ! -L "$source" ] || return 1
	if [ -n "$mixin_override" ]; then
		case "$mixin_override" in /etc/nikki-rs/mixin.yaml|/tmp/nikki-rs-edit.*) ;; *) return 1 ;; esac
		[ -f "$mixin_override" ] && [ ! -L "$mixin_override" ] || return 1
	fi

	local tmpdir
	tmpdir="$(mktemp -d /tmp/nikki-rs-preview.XXXXXX)" || return 1
	trap 'rm -rf "$tmpdir"' EXIT INT TERM

	config_load nikki-rs
	local overwrite_authentication overwrite_tun_dns_hijack overwrite_fake_ip_filter
	local overwrite_black_filter overwrite_hosts overwrite_dns_nameserver
	local overwrite_dns_proxy_server_nameserver overwrite_dns_nameserver_policy
	local ui_internal overwrite_sniffer_force_domain_name overwrite_sniffer_ignore_domain_name
	local overwrite_sniffer_sniff overwrite_mmdb overwrite_geosite overwrite_asn_mmdb
	local mixin_file_content proxy_enabled ebpf_enabled
	config_get_bool overwrite_authentication "mixin" "authentication" 0
	config_get_bool overwrite_tun_dns_hijack "mixin" "tun_dns_hijack" 0
	config_get_bool overwrite_fake_ip_filter "mixin" "fake_ip_filter" 0
	config_get_bool overwrite_black_filter "mixin" "black_filter" 0
	config_get_bool overwrite_hosts "mixin" "hosts" 0
	config_get_bool overwrite_dns_nameserver "mixin" "dns_nameserver" 0
	config_get_bool overwrite_dns_proxy_server_nameserver "mixin" "dns_proxy_server_nameserver" 0
	config_get_bool overwrite_dns_nameserver_policy "mixin" "dns_nameserver_policy" 0
	config_get_bool ui_internal "mixin" "ui_internal" 0
	config_get_bool overwrite_sniffer_force_domain_name "mixin" "sniffer_force_domain_name" 0
	config_get_bool overwrite_sniffer_ignore_domain_name "mixin" "sniffer_ignore_domain_name" 0
	config_get_bool overwrite_sniffer_sniff "mixin" "sniffer_sniff" 0
	config_get_bool overwrite_mmdb "mixin" "overwrite_mmdb" 0
	config_get_bool overwrite_geosite "mixin" "overwrite_geosite" 0
	config_get_bool overwrite_asn_mmdb "mixin" "overwrite_asn_mmdb" 0
	config_get_bool mixin_file_content "mixin" "mixin_file_content" 0
	config_get_bool proxy_enabled "proxy" "enabled" 0
	config_get_bool ebpf_enabled "ebpf" "enabled" 0

	local saved_mixin_file="$MIXIN_FILE_PATH"
	local saved_app_log="$APP_LOG_PATH"
	local saved_run_dir="$RUN_DIR"
	local saved_run_profile="$RUN_PROFILE_PATH"
	# mixin_profile installs its own EXIT trap, which replaces the one above in
	# this shell. Restore our cleanup on every exit path so preview workspaces
	# never accumulate in the router's RAM-backed /tmp.
	restore_preview() {
		MIXIN_FILE_PATH="$saved_mixin_file"
		APP_LOG_PATH="$saved_app_log"
		RUN_DIR="$saved_run_dir"
		RUN_PROFILE_PATH="$saved_run_profile"
	}
	cleanup_preview() {
		restore_preview
		rm -rf "$tmpdir"
	}
	trap 'cleanup_preview' EXIT INT TERM
	RUN_DIR="$tmpdir"
	RUN_PROFILE_PATH="$tmpdir/config.yaml"
	APP_LOG_PATH="$tmpdir/app.log"
	if [ -n "$mixin_override" ]; then
		MIXIN_FILE_PATH="$mixin_override"
	fi
	cp -f "$source" "$RUN_PROFILE_PATH" || return 1
	preview_mode=1
	mixin_profile 2>> "$APP_LOG_PATH" || return 1
	cp -f "$RUN_PROFILE_PATH" "$output" || return 1
	cleanup_preview
	trap - EXIT INT TERM
	return 0
}

start_service() {
	# prepare files
	prepare_files
	# load config
	config_load nikki-rs
	# check if enabled
	local enabled
	config_get_bool enabled "config" "enabled" 0
	if [ "$enabled" = 0 ]; then
		log "App" "Disabled."
		log "App" "Exit."
		return
	fi
	# start
	log "App" "Enabled."
	log "App" "Start."
	# check if executable
	if [ ! -x $PROG ]; then
		log "App" "Core is not executable."
		log "App" "Exit."
		return
	fi
	# get config
	## app config
	local scheduled_restart scheduled_restart_cron profile test_profile core_only
	config_get_bool scheduled_restart "config" "scheduled_restart" 0
	config_get scheduled_restart_cron "config" "scheduled_restart_cron"
	config_get profile "config" "profile"
	config_get_bool test_profile "config" "test_profile" 0
	config_get_bool core_only "config" "core_only" 0
	## procd config
	### general
	local fast_reload
	config_get_bool fast_reload "procd" "fast_reload" 0
	### rlimit
	local rlimit_nproc_soft rlimit_nproc_hard rlimit_address_space_soft rlimit_address_space_hard rlimit_data_soft rlimit_data_hard rlimit_stack_soft rlimit_stack_hard rlimit_nofile_soft rlimit_nofile_hard
	config_get rlimit_nproc_soft "procd" "rlimit_nproc_soft" "$(ulimit -Su)"
	config_get rlimit_nproc_hard "procd" "rlimit_nproc_hard" "$(ulimit -Hu)"
	config_get rlimit_address_space_soft "procd" "rlimit_address_space_soft"
	config_get rlimit_address_space_hard "procd" "rlimit_address_space_hard"
	config_get rlimit_data_soft "procd" "rlimit_data_soft"
	config_get rlimit_data_hard "procd" "rlimit_data_hard"
	config_get rlimit_stack_soft "procd" "rlimit_stack_soft"
	config_get rlimit_stack_hard "procd" "rlimit_stack_hard"
	config_get rlimit_nofile_soft "procd" "rlimit_nofile_soft" "$(ulimit -Sn)"
	config_get rlimit_nofile_hard "procd" "rlimit_nofile_hard" "$(ulimit -Hn)"
	## mixin config
	### overwrite
	local overwrite_authentication overwrite_tun_dns_hijack overwrite_fake_ip_filter overwrite_black_filter overwrite_hosts overwrite_dns_nameserver overwrite_dns_proxy_server_nameserver overwrite_dns_nameserver_policy ui_internal overwrite_sniffer_force_domain_name overwrite_sniffer_ignore_domain_name overwrite_sniffer_sniff overwrite_mmdb overwrite_geosite overwrite_asn_mmdb
	config_get_bool overwrite_authentication "mixin" "authentication" 0
	config_get_bool overwrite_tun_dns_hijack "mixin" "tun_dns_hijack" 0
	config_get_bool overwrite_fake_ip_filter "mixin" "fake_ip_filter" 0
	config_get_bool overwrite_black_filter "mixin" "black_filter" 0
	config_get_bool overwrite_hosts "mixin" "hosts" 0
	config_get_bool overwrite_dns_nameserver "mixin" "dns_nameserver" 0
	config_get_bool overwrite_dns_proxy_server_nameserver "mixin" "dns_proxy_server_nameserver" 0
	config_get_bool overwrite_dns_nameserver_policy "mixin" "dns_nameserver_policy" 0
	config_get_bool ui_internal "mixin" "ui_internal" 0
	config_get_bool overwrite_sniffer_force_domain_name "mixin" "sniffer_force_domain_name" 0
	config_get_bool overwrite_sniffer_ignore_domain_name "mixin" "sniffer_ignore_domain_name" 0
	config_get_bool overwrite_sniffer_sniff "mixin" "sniffer_sniff" 0
	config_get_bool overwrite_mmdb "mixin" "overwrite_mmdb" 0
	config_get_bool overwrite_geosite "mixin" "overwrite_geosite" 0
	config_get_bool overwrite_asn_mmdb "mixin" "overwrite_asn_mmdb" 0
	### mixin file content
	local mixin_file_content
	config_get_bool mixin_file_content "mixin" "mixin_file_content" 0
	## core config
	local redirect_listener_name tproxy_listener_name tun_listener_name
	config_get redirect_listener_name "core" "redirect_listener_name"
	config_get tproxy_listener_name "core" "tproxy_listener_name"
	config_get tun_listener_name "core" "tun_listener_name"
	## proxy config
	local proxy_enabled ipv4_dns_hijack ipv6_dns_hijack tcp_mode udp_mode
	config_get_bool proxy_enabled "proxy" "enabled" 0
	config_get_bool ipv4_dns_hijack "proxy" "ipv4_dns_hijack" 0
	config_get_bool ipv6_dns_hijack "proxy" "ipv6_dns_hijack" 0
	config_get tcp_mode "proxy" "tcp_mode"
	config_get udp_mode "proxy" "udp_mode"
	## ebpf config
	local ebpf_enabled
	config_get_bool ebpf_enabled "ebpf" "enabled" 0
	## log config
	local log_scheduled_clear log_scheduled_clear_cron
	config_get_bool log_scheduled_clear "log" "scheduled_clear" 0
	config_get log_scheduled_clear_cron "log" "scheduled_clear_cron"
	# get profile
	local profile_type; profile_type=$(echo "$profile" | cut -d ':' -f 1)
	local profile_id; profile_id=$(echo "$profile" | cut -d ':' -f 2)
	if [ "$profile_type" = "file" ]; then
		local profile_name; profile_name="$profile_id"
		local profile_file; profile_file="$PROFILES_DIR/$profile_name"
		log "Profile" "Use file: $profile_name."
		if [ ! -f "$profile_file" ]; then
			log "Profile" "File not found."
			log "App" "Exit."
			return
		fi
		cp -f "$profile_file" "$RUN_PROFILE_PATH"
	elif [ "$profile_type" = "subscription" ]; then
		local subscription_section; subscription_section="$profile_id"
		local subscription_name subscription_prefer
		config_get subscription_name "$subscription_section" "name"
		config_get subscription_prefer "$subscription_section" "prefer" "remote"
		log "Profile" "Use subscription: $subscription_name."
		local subscription_file; subscription_file="$SUBSCRIPTIONS_DIR/$subscription_section.yaml"
		if [ "$subscription_prefer" = "remote" ] || [ ! -f "$subscription_file" ]; then
			update_subscription "$subscription_section"
		fi
		if [ ! -f "$subscription_file" ]; then
			log "Profile" "Subscription file not found."
			log "App" "Exit."
			return
		fi
		cp -f "$subscription_file" "$RUN_PROFILE_PATH"
	else
		log "Profile" "No profile/subscription selected."
		log "App" "Exit."
		return
	fi
	# mixin
	if [ "$core_only" = 0 ]; then
		if ! mixin_profile; then
			log "Mixin" "Mixin failed. Please check the app log."
			log "App" "Exit."
			return 1
		fi
	fi
	# check profile
	if [ "$core_only" = 0 ] && [ "$proxy_enabled" = 1 ] && [ "$ebpf_enabled" = 0 ]; then
		log "Profile" "Checking..."
		if [ "$ipv4_dns_hijack" = 1 ] || [ "$ipv6_dns_hijack" = 1 ]; then
			if yq -M -e '((.dns2.enable == true and .dns2.listen != null) or (.dns2.enable != true and .dns.enable == true and .dns.listen != null)) | not' "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "DNS should be enabled and listen should be defined."
				log "App" "Exit."
				return
			fi
		fi
		if [ "$tcp_mode" = "redirect" ]; then
			if yq -M -e "(has(\"redir-port\") or (has(\"listeners\") and .listeners | any_c(.name == \"$redirect_listener_name\" and .type == \"redir\"))) | not" "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "Redirect Port/Listener should be defined."
				log "App" "Exit."
				return
			fi
		fi
		if [ "$tcp_mode" = "tproxy" ] || [ "$udp_mode" = "tproxy" ]; then
			if yq -M -e "(has(\"tproxy-port\") or (has(\"listeners\") and .listeners | any_c(.name == \"$tproxy_listener_name\" and .type == \"tproxy\"))) | not" "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "TPROXY Port/Listener should be defined."
				log "App" "Exit."
				return
			fi
		fi
		if [ "$tcp_mode" = "tun" ] || [ "$udp_mode" = "tun" ]; then
			if ! yq -M -e "((.tun.enable == true and .tun.device != null) or ((.listeners // []) | any_c(.name == \"$tun_listener_name\" and .type == \"tun\" and .device != null)))" "$RUN_PROFILE_PATH" >> "$APP_LOG_PATH" 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "TUN should be defined."
				log "App" "Exit."
				return 1
			fi
		fi
		log "Profile" "Check passed."
	elif [ "$core_only" = 0 ] && [ "$ebpf_enabled" = 1 ]; then
		log "Profile" "Checking eBPF..."
		if yq -M -e '(has("ebpf") and (.ebpf | .enable)) | not' "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
			log "Profile" "Check failed."
			log "Profile" "eBPF should be enabled and defined."
			log "App" "Exit."
			return
		fi
		log "Profile" "Check passed."
	fi
	# test profile
	if [ "$test_profile" = 1 ]; then
		log "Profile" "Testing..."
		if $PROG -d "$RUN_DIR" -t >> "$CORE_LOG_PATH" 2>&1; then
			log "Profile" "Test passed."
		else
			log "Profile" "Test failed."
			log "Profile" "Please check the core log to find out the problem."
			log "App" "Exit."
			return
		fi
	fi
	# start core
	log "Core" "Start."
	procd_open_instance nikki-rs

	procd_set_param command /bin/sh -c "exec $PROG -d $RUN_DIR >> $CORE_LOG_PATH 2>&1"
	procd_set_param file "$RUN_PROFILE_PATH"
	if [ "$fast_reload" = 1 ]; then
		procd_set_param reload_signal HUP
	fi
	procd_set_param pidfile "$PID_FILE_PATH"
	procd_set_param respawn

	procd_append_param limits nproc="${rlimit_nproc_soft} ${rlimit_nproc_hard}"
	procd_append_param limits as="${rlimit_address_space_soft:-unlimited} ${rlimit_address_space_hard:-unlimited}"
	procd_append_param limits data="${rlimit_data_soft:-unlimited} ${rlimit_data_hard:-unlimited}"
	procd_append_param limits stack="${rlimit_stack_soft:-unlimited} ${rlimit_stack_hard:-unlimited}"
	procd_append_param limits nofile="${rlimit_nofile_soft} ${rlimit_nofile_hard}"

	procd_close_instance
	# cron
	mkdir -p "/etc/crontabs"
	touch "/etc/crontabs/root"
	sed -i "/#nikki-rs/d" "/etc/crontabs/root" > /dev/null 2>&1
	if [ "$scheduled_restart" = 1 ] && [ -n "$scheduled_restart_cron" ]; then
		log "App" "Set scheduled restart."
		echo "$scheduled_restart_cron /etc/init.d/nikki-rs restart #nikki-rs scheduled restart" >> "/etc/crontabs/root"
	fi
	if [ "$log_scheduled_clear" = 1 ] && [ -n "$log_scheduled_clear_cron" ]; then
		log "App" "Set log scheduled clear."
		echo "$log_scheduled_clear_cron /etc/init.d/nikki-rs clear_logs #nikki-rs log scheduled clear" >> "/etc/crontabs/root"
	fi
	local mixin_rule_provider rule_provider_scheduled_update rule_provider_scheduled_update_cron
	config_get_bool mixin_rule_provider "mixin" "rule_provider" 0
	config_get_bool rule_provider_scheduled_update "mixin" "rule_provider_scheduled_update" 0
	config_get rule_provider_scheduled_update_cron "mixin" "rule_provider_scheduled_update_cron" "0 3 * * *"
	if [ "$mixin_rule_provider" = 1 ] && [ "$rule_provider_scheduled_update" = 1 ] && [ -n "$rule_provider_scheduled_update_cron" ]; then
		log "App" "Set scheduled update for rule providers."
		echo "$rule_provider_scheduled_update_cron /etc/init.d/nikki-rs update_rule_provider #nikki-rs rule_provider scheduled update" >> "/etc/crontabs/root"
	fi
	# Optional weekly unattended core updates (disabled by default).
	local core_auto_update core_update_cron
	config_get_bool core_auto_update "core_update" "auto_update" 0
	config_get core_update_cron "core_update" "cron" "15 4 * * 0"
	if [ "$core_auto_update" = 1 ]; then
		echo "$core_update_cron /etc/nikki-rs/scripts/core-manager.sh update >> /var/log/nikki-rs/core-update.log 2>&1 #nikki-rs core update" >> "/etc/crontabs/root"
	fi
	# set started flag
	touch "$STARTED_FLAG_PATH"
}

service_started() {
	# check if started
	if [ ! -f "$STARTED_FLAG_PATH" ]; then
		return
	fi
	# load config
	config_load nikki-rs
	# check if ebpf enabled
	local ebpf_enabled
	config_get_bool ebpf_enabled "ebpf" "enabled" 0
	if [ "$ebpf_enabled" = 1 ]; then
		log "Proxy" "eBPF is enabled, external nftables hijack and routing rules are bypassed."
		return
	fi
	# check if proxy enabled
	local proxy_enabled
	config_get_bool proxy_enabled "proxy" "enabled" 0
	if [ "$proxy_enabled" = 0 ]; then
		log "Proxy" "Disabled."
		return
	fi
	# get config
	## app config
	local core_only
	config_get_bool core_only "config" "core_only" 0
	## core
	local tun_listener_name
	config_get tun_listener_name "core" "tun_listener_name"
	## proxy config
	### general
	local tcp_mode udp_mode ipv4_proxy ipv6_proxy tun_timeout tun_interval
	config_get tcp_mode "proxy" "tcp_mode"
	config_get udp_mode "proxy" "udp_mode"
	config_get_bool ipv4_proxy "proxy" "ipv4_proxy" 0
	config_get_bool ipv6_proxy "proxy" "ipv6_proxy" 0
	config_get tun_timeout "proxy" "tun_timeout" 30
	config_get tun_interval "proxy" "tun_interval" 1
	## routing config
	local tproxy_fw_mark tproxy_fw_mask tun_fw_mark tun_fw_mask tproxy_rule_pref tun_rule_pref tproxy_route_table tun_route_table cgroup_id cgroup_name dummy_device
	config_get tproxy_fw_mark "routing" "tproxy_fw_mark" "0x82"
	config_get tproxy_fw_mask "routing" "tproxy_fw_mask" "0xFF"
	config_get tun_fw_mark "routing" "tun_fw_mark" "0x83"
	config_get tun_fw_mask "routing" "tun_fw_mask" "0xFF"
	config_get tproxy_rule_pref "routing" "tproxy_rule_pref" "1026"
	config_get tun_rule_pref "routing" "tun_rule_pref" "1027"
	config_get tproxy_route_table "routing" "tproxy_route_table" "82"
	config_get tun_route_table "routing" "tun_route_table" "83"
	config_get cgroup_id "routing" "cgroup_id" "0x12071207"
	config_get cgroup_name "routing" "cgroup_name" "nikki-rs"
	config_get dummy_device "routing" "dummy_device" "nikki-rs-dummy"
	# prepare config
	local tproxy_enable; tproxy_enable=0
	if [ "$tcp_mode" = "tproxy" ] || [ "$udp_mode" = "tproxy" ]; then
		tproxy_enable=1
	fi
	local tun_enable; tun_enable=0
	if [ "$tcp_mode" = "tun" ] || [ "$udp_mode" = "tun" ]; then
		tun_enable=1
	fi
	local dns_mode; dns_mode=$(yq -M '.dns.enhanced-mode // ""' "$RUN_PROFILE_PATH")
	local fake_ip6_range; fake_ip6_range=$(yq -M '.dns.fake-ip-range6 // ""' "$RUN_PROFILE_PATH")
	if yq -M -e '.dns2.enable == true' "$RUN_PROFILE_PATH" > /dev/null 2>&1; then
		dns_mode=""
		fake_ip6_range=$(yq -M '[.dns2.upstreams[] | select(.type == "fakeip") | .inet6-range][0] // ""' "$RUN_PROFILE_PATH")
		[ -n "$fake_ip6_range" ] && dns_mode="fake-ip"
	fi
	local tun_device; tun_device=$(yq -M "(.tun | select(.enable) | .device) // ([(.listeners // [])[] | select(.name == \"$tun_listener_name\" and .type == \"tun\") | .device][0])" "$RUN_PROFILE_PATH")
	if [ "$core_only" = 0 ]; then
		# proxy
		log "Proxy" "Enabled."
		# wait for tun device online
		if [ "$tun_enable" = 1 ]; then
			log "Proxy" "Waiting for tun device online within $tun_timeout seconds..."
			while [ "$tun_timeout" -gt 0 ]; do
				if ip -j link show dev "$tun_device" 2>/dev/null | jsonfilter -q -e "@[@['flags'][@='UP']]" > /dev/null 2>&1; then
					log "Proxy" "TUN device is online."
					break
				fi
				tun_timeout=$((tun_timeout - tun_interval))
				sleep "$tun_interval"
			done
			if [ "$tun_timeout" -le 0 ]; then
				log "Proxy" "Timeout, TUN device is not online."
				log "App" "Exit."
				return
			fi
		fi
		# fix compatible with dockerd
		## cgroupfs-mount
		### when cgroupfs-mount is installed, cgroupv1 will mounted instead of cgroupv2, we need to create cgroup manually
		if mount | grep -q -w "^cgroup"; then
			mkdir -p "/sys/fs/cgroup/net_cls/$cgroup_name"
			echo "$cgroup_id" > "/sys/fs/cgroup/net_cls/$cgroup_name/net_cls.classid"
			cat "$PID_FILE_PATH" > "/sys/fs/cgroup/net_cls/$cgroup_name/cgroup.procs"
		fi
		## kmod-br-netfilter
		### when kmod-br-netfilter is loaded, bridge-nf-call-iptables and bridge-nf-call-ip6tables are set to 1, we need to set them to 0 if tproxy is enabled
		if [ "$tproxy_enable" = 1 ] && (lsmod | grep -q br_netfilter); then
			if [ "$ipv4_proxy" = 1 ]; then
				local bridge_nf_call_iptables; bridge_nf_call_iptables=$(sysctl -e -n net.bridge.bridge-nf-call-iptables)
				if [ "$bridge_nf_call_iptables" = 1 ]; then
					touch "$BRIDGE_NF_CALL_IPTABLES_FLAG_PATH"
					sysctl -q -w net.bridge.bridge-nf-call-iptables=0
				fi
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				local bridge_nf_call_ip6tables; bridge_nf_call_ip6tables=$(sysctl -e -n net.bridge.bridge-nf-call-ip6tables)
				if [ "$bridge_nf_call_ip6tables" = 1 ]; then
					touch "$BRIDGE_NF_CALL_IP6TABLES_FLAG_PATH"
					sysctl -q -w net.bridge.bridge-nf-call-ip6tables=0
				fi
			fi
		fi
		# ip route and rule
		if [ "$tproxy_enable" = 1 ]; then
			if [ "$ipv4_proxy" = 1 ]; then
				ip -4 route add local default dev lo table "$tproxy_route_table"
				ip -4 rule add pref "$tproxy_rule_pref" fwmark "$tproxy_fw_mark/$tproxy_fw_mask" table "$tproxy_route_table"
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				ip -6 route add local default dev lo table "$tproxy_route_table"
				ip -6 rule add pref "$tproxy_rule_pref" fwmark "$tproxy_fw_mark/$tproxy_fw_mask" table "$tproxy_route_table"
			fi
		fi
		if [ "$tun_enable" = 1 ]; then
			if [ "$ipv4_proxy" = 1 ]; then
				ip -4 route add unicast default dev "$tun_device" table "$tun_route_table"
				ip -4 rule add pref "$tun_rule_pref" fwmark "$tun_fw_mark/$tun_fw_mask" table "$tun_route_table"
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				ip -6 route add unicast default dev "$tun_device" table "$tun_route_table"
				ip -6 rule add pref "$tun_rule_pref" fwmark "$tun_fw_mark/$tun_fw_mask" table "$tun_route_table"
			fi
			$FIREWALL_INCLUDE_SH
		fi
		if [ "$dns_mode" = "fake-ip" ] && [ -n "$fake_ip6_range" ]; then
			ip link add "$dummy_device" type dummy
			ip link set dev "$dummy_device" up
			ip -6 route add "$fake_ip6_range" dev "$dummy_device"
		fi
		# hijack
		utpl -S "$HIJACK_UT" | nft -f -
		# check hijack
		if nft list tables | grep -q nikki-rs; then
			log "Proxy" "Hijack successful."
		else
			log "Proxy" "Hijack failed."
			log "App" "Exit."
		fi
	fi
}

service_stopped() {
	cleanup
}

reload_service() {
	cleanup
	start
}

service_triggers() {
	procd_add_reload_trigger "nikki-rs"
}

cleanup() {
	# load config
	config_load nikki-rs
	# get config
	## log config
	local log_clear_at_stop
	config_get_bool log_clear_at_stop "log" "clear_at_stop" 0
	## routing config
	local tproxy_route_table tun_route_table dummy_device
	config_get tproxy_route_table "routing" "tproxy_route_table" "82"
	config_get tun_route_table "routing" "tun_route_table" "83"
	config_get dummy_device "routing" "dummy_device" "nikki-rs-dummy"
	# clear logs if needed
	if [  "$log_clear_at_stop" = 1 ]; then
		echo -n > "$APP_LOG_PATH"
		echo -n > "$CORE_LOG_PATH"
		log "Log" "Logs are cleared due to clear at stop is enabled."
	fi
	# delete routing policy
	ip -4 rule del table "$tproxy_route_table" > /dev/null 2>&1
	ip -4 rule del table "$tun_route_table" > /dev/null 2>&1
	ip -6 rule del table "$tproxy_route_table" > /dev/null 2>&1
	ip -6 rule del table "$tun_route_table" > /dev/null 2>&1
	# delete routing table
	ip -4 route flush table "$tproxy_route_table" > /dev/null 2>&1
	ip -4 route flush table "$tun_route_table" > /dev/null 2>&1
	ip -6 route flush table "$tproxy_route_table" > /dev/null 2>&1
	ip -6 route flush table "$tun_route_table" > /dev/null 2>&1
	# delete dummy device
	ip -6 link del "$dummy_device" > /dev/null 2>&1
	# delete hijack
	nft delete table inet nikki-rs > /dev/null 2>&1
	local fw4_rules delete_rules chain handles handle
	if fw4_rules=$(nft --json list table inet fw4 2>/dev/null); then
		delete_rules=$(
			for chain in input forward; do
				handles=$(printf '%s\n' "$fw4_rules" | jsonfilter -q -e "@['nftables'][@['rule']['chain']='$chain' && @['rule']['comment']='nikki-rs']['rule']['handle']")
				for handle in $handles; do
					printf 'delete rule inet fw4 %s handle %s\n' "$chain" "$handle"
				done
			done
		)
		if [ -n "$delete_rules" ]; then
			printf '%s\n' "$delete_rules" | nft -f -
		fi
	fi
	# delete started flag
	rm "$STARTED_FLAG_PATH" > /dev/null 2>&1
	# revert fix compatible with dockerd
	## kmod-br-netfilter
	if rm "$BRIDGE_NF_CALL_IPTABLES_FLAG_PATH" > /dev/null 2>&1; then
		sysctl -q -w net.bridge.bridge-nf-call-iptables=1
	fi
	if rm "$BRIDGE_NF_CALL_IP6TABLES_FLAG_PATH" > /dev/null 2>&1; then
		sysctl -q -w net.bridge.bridge-nf-call-ip6tables=1
	fi
	# delete cron
	sed -i "/#nikki-rs/d" "/etc/crontabs/root" > /dev/null 2>&1
}

clear_logs() {
	# load config
	config_load nikki-rs
	# get config
	## log config
	local log_scheduled_clear_size_limit log_scheduled_clear_size_limit_unit
	config_get log_scheduled_clear_size_limit "log" "scheduled_clear_size_limit" 1
	config_get log_scheduled_clear_size_limit_unit "log" "scheduled_clear_size_limit_unit" "MB"
	# prepare config
	local log_scheduled_clear_size_limit_in_bytes; log_scheduled_clear_size_limit_in_bytes=0
	case "$log_scheduled_clear_size_limit_unit" in
		B)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit))
		;;
		KB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024))
		;;
		MB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024 * 1024))
		;;
		GB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024 * 1024 * 1024))
		;;
	esac
	# clear logs
	if [ -f "$APP_LOG_PATH" ] && [ "$(wc -c < "$APP_LOG_PATH")" -ge "$log_scheduled_clear_size_limit_in_bytes" ]; then
		echo -n > "$APP_LOG_PATH"
		log "Log" "App log is cleared due to scheduled clear and exceeding size limits."
	fi
	if [ -f "$CORE_LOG_PATH" ] && [ "$(wc -c < "$CORE_LOG_PATH")" -ge "$log_scheduled_clear_size_limit_in_bytes" ]; then
		echo -n > "$CORE_LOG_PATH"
		log "Log" "Core log is cleared due to scheduled clear and exceeding size limits."
	fi
}

subscription_fetch() {
	local proxy="$1" headers="$2" output="$3" url="$4" user_agent="$5" errfile="$6" max_time="$7" connect_time="$8" retries="$9"
	local http_status curl_rc curl_error
	: > "$errfile"
	if [ -n "$proxy" ]; then
		http_status=$(curl -sS -f -m "$max_time" --connect-timeout "$connect_time" --retry "$retries" -L -X GET -A "$user_agent" -x "$proxy" -D "$headers" -o "$output" -w '%{http_code}' "$url" 2>"$errfile")
	else
		http_status=$(curl -sS -f -m "$max_time" --connect-timeout "$connect_time" --retry "$retries" -L -X GET -A "$user_agent" -D "$headers" -o "$output" -w '%{http_code}' "$url" 2>"$errfile")
	fi
	curl_rc=$?
	subscription_curl_status="$http_status"
	subscription_curl_reason=''
	[ "$curl_rc" -eq 0 ] && return 0
	curl_error=$(sed -n 's/.*curl: (\([0-9][0-9]*\)).*/\1/p' "$errfile" | tail -n 1)
	case "$http_status" in
		[45][0-9][0-9])
			case "$http_status" in
				401) subscription_curl_reason='HTTP 401: authentication required' ;;
				403) subscription_curl_reason='HTTP 403: access denied' ;;
				404) subscription_curl_reason='HTTP 404: subscription URL not found' ;;
				429) subscription_curl_reason='HTTP 429: request rate limited' ;;
				5*) subscription_curl_reason="HTTP $http_status: subscription server error" ;;
				*) subscription_curl_reason="HTTP $http_status: request rejected" ;;
			esac
			;;
		*)
			[ -n "$http_status" ] || http_status=unknown
			case "$curl_error" in
				3) subscription_curl_reason='Invalid or unsupported subscription URL' ;;
				5) subscription_curl_reason='Could not resolve the proxy server' ;;
				6) subscription_curl_reason='Could not resolve the subscription host (DNS)' ;;
				7) subscription_curl_reason='Could not connect to the subscription server' ;;
				22) subscription_curl_reason="HTTP request failed (status $http_status)" ;;
				28) subscription_curl_reason='Connection timed out' ;;
				35) subscription_curl_reason='TLS handshake failed' ;;
				52|56) subscription_curl_reason='Connection closed or interrupted while receiving data' ;;
				60) subscription_curl_reason='TLS certificate validation failed' ;;
				'') subscription_curl_reason="Download failed (curl exit $curl_rc)" ;;
				*) subscription_curl_reason="Download failed (curl error $curl_error)" ;;
			esac
			;;
	esac
	return 1
}

update_subscription() {
	local subscription_section; subscription_section="$1"
	if [ -z "$subscription_section" ]; then
		return 1
	fi
	mkdir -p "$TEMP_DIR"
	local update_lock="$TEMP_DIR/subscription-$subscription_section.lock"
	if [ -d "$update_lock" ]; then
		local old_pid
		old_pid=$(cat "$update_lock/pid" 2>/dev/null || true)
		case "$old_pid" in ''|*[!0-9]*) ;; *)
			if kill -0 "$old_pid" 2>/dev/null; then
				log "Profile" "Subscription update already running: $subscription_section."
				return 1
			fi ;;
		esac
		rm -rf "$update_lock"
	fi
	mkdir "$update_lock" 2>/dev/null || return 1
	printf '%s\n' "$$" > "$update_lock/pid"
	# load config
	config_load nikki-rs
	# get subscription config
	local subscription_name subscription_info_url subscription_url subscription_user_agent
	config_get subscription_name "$subscription_section" "name"
	config_get subscription_info_url "$subscription_section" "info_url"
	config_get subscription_url "$subscription_section" "url"
	config_get subscription_user_agent "$subscription_section" "user_agent"
	# Keep the last successful quota/update data until a new update succeeds.
	# Only reset the transient error state at the start of a new attempt.
	uci_remove "nikki-rs" "$subscription_section" "error" > /dev/null 2>&1
	uci_set "nikki-rs" "$subscription_section" "success" "0"
	uci_set "nikki-rs" "$subscription_section" "updating" "1"
	uci_set "nikki-rs" "$subscription_section" "last_attempt" "$(date "+%Y-%m-%d %H:%M:%S")"
	uci_commit "nikki-rs"
	# update subscription
	log "Profile" "Update subscription: $subscription_name."
	local success subscription_error proxy_error direct_error
	subscription_error=''
	proxy_error=''
	direct_error=''
	local subscription_info_header_tmpfile; subscription_info_header_tmpfile="$TEMP_DIR/$subscription_section.info.header"
	local subscription_header_tmpfile; subscription_header_tmpfile="$TEMP_DIR/$subscription_section.header"
	local subscription_tmpfile; subscription_tmpfile="$TEMP_DIR/$subscription_section.yaml"
	local subscription_info_file
	local subscription_file; subscription_file="$SUBSCRIPTIONS_DIR/$subscription_section.yaml"
	local mixed_port; config_get mixed_port "mixin" "mixed_port" "7890"
	# Fetch quota metadata opportunistically; its failure does not invalidate the YAML.
	if [ -n "$subscription_info_url" ]; then
		log "Profile" "Fetch subscription info."
		local info_downloaded=0 info_errfile="$TEMP_DIR/$subscription_section.info.err"
		if [ -n "$mixed_port" ] && subscription_fetch "http://127.0.0.1:$mixed_port" "$subscription_info_header_tmpfile" /dev/null "$subscription_info_url" "$subscription_user_agent" "$info_errfile" 60 10 1; then
			info_downloaded=1
		fi
		if [ "$info_downloaded" = 0 ] && subscription_fetch '' "$subscription_info_header_tmpfile" /dev/null "$subscription_info_url" "$subscription_user_agent" "$info_errfile" 120 15 3; then
			info_downloaded=1
		fi
		if [ ! -f "$subscription_info_file" ] && grep -q -i "subscription-userinfo:" "$subscription_info_header_tmpfile" 2>/dev/null; then
			subscription_info_file="$subscription_info_header_tmpfile"
		fi
		rm -f "$info_errfile"
	fi
	# download subscription and retain a safe, actionable failure summary
	log "Profile" "Download subscription."
	local sub_downloaded=0 subscription_errfile="$TEMP_DIR/$subscription_section.download.err"
	if [ -n "$mixed_port" ]; then
		if subscription_fetch "http://127.0.0.1:$mixed_port" "$subscription_header_tmpfile" "$subscription_tmpfile" "$subscription_url" "$subscription_user_agent" "$subscription_errfile" 60 10 1; then
			sub_downloaded=1
		else
			proxy_error="$subscription_curl_reason"
		fi
	fi
	if [ "$sub_downloaded" = 0 ]; then
		if subscription_fetch '' "$subscription_header_tmpfile" "$subscription_tmpfile" "$subscription_url" "$subscription_user_agent" "$subscription_errfile" 120 15 3; then
			sub_downloaded=1
		else
			direct_error="$subscription_curl_reason"
		fi
	fi
	if [ "$sub_downloaded" = 1 ]; then
		log "Profile" "Subscription download successful."
		if [ -z "$subscription_info_file" ] && grep -q -i "subscription-userinfo:" "$subscription_header_tmpfile"; then
			subscription_info_file="$subscription_header_tmpfile"
		fi
		if [ ! -s "$subscription_tmpfile" ]; then
			subscription_error='The subscription server returned an empty file.'
			success=0
		else
			local validation_output validation_line
			validation_output=$(yq -M -p yaml -o yaml -e 'has("proxies") or has("proxy-providers")' "$subscription_tmpfile" 2>&1 > /dev/null)
			if [ "$?" -eq 0 ]; then
				log "Profile" "Subscription is valid."
				success=1
			else
				validation_line=$(printf '%s\n' "$validation_output" | sed -n 's/.*line \([0-9][0-9]*\).*/\1/p' | head -n 1)
				if [ -n "$validation_line" ]; then
					subscription_error="Downloaded content is not valid Clash YAML (parser line $validation_line)."
				else
					subscription_error='Downloaded YAML has no proxies or proxy-providers section, or contains invalid syntax.'
				fi
				log "Profile" "Subscription validation failed: $subscription_error"
				success=0
			fi
		fi
	else
		if [ -n "$proxy_error" ] && [ -n "$direct_error" ]; then
			subscription_error="Proxy attempt: $proxy_error; direct attempt: $direct_error."
		elif [ -n "$direct_error" ]; then
			subscription_error="$direct_error."
		elif [ -n "$proxy_error" ]; then
			subscription_error="$proxy_error."
		else
			subscription_error='Download failed for an unknown reason.'
		fi
		log "Profile" "Subscription download failed: $subscription_error"
		success=0
	fi
	rm -f "$subscription_errfile"
	# check if success
	if [ "$success" = 1 ]; then
		log "Profile" "Subscription update successful."
		if [ -f "$subscription_info_file" ]; then
			local subscription_expire subscription_upload subscription_download subscription_total subscription_used subscription_avaliable
			subscription_expire=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "expire=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_upload=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "upload=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_download=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "download=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_total=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "total=[[:digit:]]+" | cut -d '=' -f 2)
			if [ -n "$subscription_upload" ] && [ -n "$subscription_download" ]; then
				subscription_used=$((subscription_upload + subscription_download))
				if [ -n "$subscription_total" ]; then
					subscription_avaliable=$((subscription_total - subscription_used))
				fi
			fi
			# update subscription info
			if [ -n "$subscription_expire" ]; then
				uci_set "nikki-rs" "$subscription_section" "expire" "$(date "+%Y-%m-%d %H:%M:%S" -d "@$subscription_expire")"
			fi
			if [ -n "$subscription_upload" ]; then
				uci_set "nikki-rs" "$subscription_section" "upload" "$(format_filesize "$subscription_upload")"
			fi
			if [ -n "$subscription_download" ]; then
				uci_set "nikki-rs" "$subscription_section" "download" "$(format_filesize "$subscription_download")"
			fi
			if [ -n "$subscription_total" ]; then
				uci_set "nikki-rs" "$subscription_section" "total" "$(format_filesize "$subscription_total")"
			fi
			if [ -n "$subscription_used" ]; then
				uci_set "nikki-rs" "$subscription_section" "used" "$(format_filesize "$subscription_used")"
			fi
			if [ -n "$subscription_avaliable" ]; then
				uci_set "nikki-rs" "$subscription_section" "avaliable" "$(format_filesize "$subscription_avaliable")"
			fi
		fi
		uci_set "nikki-rs" "$subscription_section" "update" "$(date "+%Y-%m-%d %H:%M:%S")"
		uci_set "nikki-rs" "$subscription_section" "success" "1"
		uci_set "nikki-rs" "$subscription_section" "updating" "0"
		uci_remove "nikki-rs" "$subscription_section" "error" > /dev/null 2>&1
		# update subscription file
		rm -f "$subscription_info_header_tmpfile"
		rm -f "$subscription_header_tmpfile"
		mv -f "$subscription_tmpfile" "$subscription_file"
	elif [ "$success" = 0 ]; then
		[ -n "$subscription_error" ] || subscription_error='Subscription update failed. See Nikki RS logs for details.'
		subscription_error=$(printf '%s' "$subscription_error" | cut -c 1-512)
		log "Profile" "Subscription update failed: $subscription_error"
		uci_set "nikki-rs" "$subscription_section" "success" "0"
		uci_set "nikki-rs" "$subscription_section" "updating" "0"
		uci_set "nikki-rs" "$subscription_section" "error" "$subscription_error"
		# remove tmpfile
		rm -f "$subscription_info_header_tmpfile"
		rm -f "$subscription_header_tmpfile"
		rm -f "$subscription_tmpfile"
	fi
	uci_commit "nikki-rs"
	rm -rf "$update_lock"
	return 0
}

prepare_rule_provider() {
	local section="$1"
	local enabled type name file_format file_path
	config_get_bool enabled "$section" "enabled" 1
	config_get type "$section" "type" "http"
	config_get name "$section" "name"
	config_get file_format "$section" "file_format" "yaml"
	config_get file_path "$section" "file_path"
	if [ "$enabled" = 1 ] && [ "$type" = "http" ]; then
		if [ -z "$file_path" ]; then
			file_path="$RULE_PROVIDERS_DIR/$name.$file_format"
		fi
		if [ ! -f "$file_path" ]; then
			log "Rule Provider" "Local file not found for $name, updating..."
			update_rule_provider_section "$section"
		fi
	fi
}

update_rule_provider_section() {
	local section="$1"
	if [ -z "$section" ]; then
		return
	fi
	local enabled type name url user_agent file_size_limit file_format file_path mixed_port
	config_get_bool enabled "$section" "enabled" 1
	config_get type "$section" "type" "http"
	config_get name "$section" "name"
	config_get url "$section" "url"
	config_get user_agent "$section" "user_agent"
	config_get file_size_limit "$section" "file_size_limit" 0
	config_get file_format "$section" "file_format" "yaml"
	config_get file_path "$section" "file_path"
	config_get mixed_port "mixin" "mixed_port" "7890"

	if [ "$enabled" = 0 ] || [ "$type" != "http" ] || [ -z "$url" ]; then
		return
	fi

	if [ -z "$file_path" ]; then
		file_path="$RULE_PROVIDERS_DIR/$name.$file_format"
	fi

	log "Rule Provider" "Update rule provider: $name."
	local tmpfile="$TEMP_DIR/rule_provider_$section.tmp"
	local downloaded=0
	local success=0

	# 1. Try download via mixed port proxy
	if [ -n "$mixed_port" ]; then
		if curl -s -f -m 60 --connect-timeout 10 --retry 1 -L -X GET ${user_agent:+-A "$user_agent"} -x "http://127.0.0.1:$mixed_port" -o "$tmpfile" "$url" > /dev/null 2>&1; then
			downloaded=1
		fi
	fi

	# 2. Try direct download if proxy failed or mixed_port empty
	if [ "$downloaded" = 0 ]; then
		if curl -s -f -m 120 --connect-timeout 15 --retry 3 -L -X GET ${user_agent:+-A "$user_agent"} -o "$tmpfile" "$url" > /dev/null 2>&1; then
			downloaded=1
		fi
	fi

	if [ "$downloaded" = 1 ]; then
		if [ -s "$tmpfile" ]; then
			local file_size; file_size=$(wc -c < "$tmpfile")
			if [ "$file_size_limit" -gt 0 ] && [ "$file_size" -gt "$file_size_limit" ]; then
				log "Rule Provider" "Rule provider file size exceeds limit: $name ($file_size > $file_size_limit)."
				success=0
			else
				success=1
			fi
		else
			log "Rule Provider" "Downloaded rule provider file is empty: $name."
			success=0
		fi
	else
		log "Rule Provider" "Rule provider download failed: $name."
		success=0
	fi

	if [ "$success" = 1 ]; then
		mkdir -p "$(dirname "$file_path")"
		mv -f "$tmpfile" "$file_path"
		uci_set "nikki-rs" "$section" "update" "$(date "+%Y-%m-%d %H:%M:%S")"
		uci_set "nikki-rs" "$section" "success" "1"
		log "Rule Provider" "Rule provider update successful: $name."
	else
		uci_set "nikki-rs" "$section" "success" "0"
		log "Rule Provider" "Rule provider update failed: $name."
		rm -f "$tmpfile"
	fi
}

update_rule_provider() {
	local section="$1"
	config_load nikki-rs
	if [ -n "$section" ]; then
		update_rule_provider_section "$section"
	else
		config_foreach update_rule_provider_section "rule_provider"
	fi
	uci_commit "nikki-rs"
}

update_china_mainland_ip() {
	config_load nikki-rs
	local url
	config_get url "proxy" "china_mainland_ip_url" "https://raw.githubusercontent.com/juewuy/ShellCrash/update/bin/geodata/china_ip_list.txt"
	if [ -z "$url" ]; then
		url="https://raw.githubusercontent.com/juewuy/ShellCrash/update/bin/geodata/china_ip_list.txt"
	fi

	local file_path="$NFT_DIR/geoip_cn.txt"
	local tmpfile="$TEMP_DIR/geoip_cn.tmp"
	local mixed_port
	config_get mixed_port "mixin" "mixed_port" "7890"

	log "Proxy" "Download China Mainland IP list from $url."
	local downloaded=0

	if [ -n "$mixed_port" ]; then
		if curl -s -f -m 60 --connect-timeout 10 --retry 1 -L -X GET -x "http://127.0.0.1:$mixed_port" -o "$tmpfile" "$url" > /dev/null 2>&1; then
			downloaded=1
		fi
	fi

	if [ "$downloaded" = 0 ]; then
		if curl -s -f -m 120 --connect-timeout 15 --retry 3 -L -X GET -o "$tmpfile" "$url" > /dev/null 2>&1; then
			downloaded=1
		fi
	fi

	if [ "$downloaded" = 1 ] && [ -s "$tmpfile" ]; then
		mkdir -p "$(dirname "$file_path")"
		mv -f "$tmpfile" "$file_path"
		log "Proxy" "China Mainland IP list update successful."
	else
		log "Proxy" "China Mainland IP list download failed."
		rm -f "$tmpfile"
		return 1
	fi
}

