#!/usr/bin/ucode

'use strict';

import { access, popen, readfile, writefile, unlink } from 'fs';
import { get_users, get_groups, get_cgroups, load_profile } from '/etc/nikki-rs/ucode/include.uc';


function allowed_override_module(module) {
    if (type(module) != 'string') return false;
    return index(['general', 'dns', 'dns2', 'proxy-groups', 'proxy-providers', 'rule-providers', 'rules', 'listeners', 'inbound-providers', 'tun', 'sniffer', 'hosts', 'geodata', 'custom'], module) >= 0;
}

function editor_path_valid(path) {
    if (type(path) != 'string') return false;
    const base = '/etc/nikki-rs/';
    if (index(path, base) != 0 || index(path, '..') >= 0 ||
        index(path, "'") >= 0 || index(path, ' ') >= 0 ||
        index(path, ';') >= 0 || index(path, '|') >= 0 ||
        index(path, '\\') >= 0) return false;
    const relative = substr(path, length(base));
    const overrideModule = match(relative, /^overrides\/([a-z-]+)\.yaml$/);
    if (overrideModule != null) return allowed_override_module(overrideModule[1]);
    const fixed = [
        'mixin.yaml', 'run/config.yaml',
        'dns/black_filter', 'dns/fake_ip_filter', 'dns/fallback_filter',
        'nftables/proxy_whitelist.txt', 'nftables/proxy_whitelist6.txt'
    ];
    if (index(fixed, relative) >= 0) return true;
    const parts = split(relative, '/');
    if (length(parts) != 2 || (parts[0] != 'profiles' && parts[0] != 'subscriptions')) return false;
    return match(parts[1], /^[a-zA-Z0-9_.-]+\.(yaml|yml)$/) != null;
}

function staged_editor_content(content) {
    if (type(content) != 'string' || length(content) > 2097152) return null;
    const process = popen('mktemp /tmp/nikki-rs-edit.XXXXXX');
    if (!process) return null;
    const path = trim(process.read('all'));
    process.close();
    if (index(path, '/tmp/nikki-rs-edit.') != 0) return null;
    if (writefile(path, content) == null) {
        unlink(path);
        return null;
    }
    return path;
}

function editor_operation(action, path, content) {
    if (!editor_path_valid(path)) return { success: false, error: 'Invalid editor path' };
    const staged = staged_editor_content(content);
    if (!staged) return { success: false, error: 'Invalid or oversized content' };
    if (action == 'validate') {
        const process = popen('/etc/nikki-rs/scripts/config-manager.sh validate ' +
            path + ' ' + staged + ' 2>&1');
        if (!process) {
            unlink(staged);
            return { success: false, error: 'Configuration validation could not be started' };
        }
        const output = trim(process.read('all'));
        process.close();
        unlink(staged);
        const success = output == 'OK';
        return { success: success, error: success ? '' : (output || 'Configuration validation failed') };
    }
    const success = system(['/etc/nikki-rs/scripts/config-manager.sh', action, path, staged]) == 0;
    unlink(staged);
    return { success: success, error: success ? '' : 'Configuration validation or file operation failed' };
}


function override_preview(module, content) {
    if (!allowed_override_module(module)) return { success: false, error: 'Unknown module' };
    const stage = staged_editor_content(content);
    if (!stage) return { success: false, error: 'Invalid or oversized YAML' };
    const base = '/etc/nikki-rs/run/base.yaml';
    if (!access(base, 'r')) {
        unlink(stage);
        return { success: false, error: 'No generated base configuration yet; start Nikki RS to generate it' };
    }
    const manager = '/etc/nikki-rs/scripts/override-manager.sh';
    const valid = system([manager, 'check', base, module, stage]) == 0;
    if (!valid) {
        unlink(stage);
        return { success: false, error: 'YAML invalid or merge failed. Check structure and module content' };
    }
    const proc = popen(manager + ' preview ' + base + ' ' + module + ' ' + stage);
    if (!proc) {
        unlink(stage);
        return { success: false, error: 'Failed to create a merged preview' };
    }
    const output = proc.read('all');
    proc.close();
    unlink(stage);
    if (length(output) > 1048576)
        return { success: false, error: 'Merged YAML exceeds 1 MiB preview limit; inspect generated config on the router' };
    return { success: length(output) > 0, content: output };
}


function config_file_hash(path) {
    const proc = popen('sha256sum ' + path + " | cut -d ' ' -f 1");
    if (!proc) return null;
    const hash = trim(proc.read('all'));
    proc.close();
    return match(hash, /^[0-9a-f]{64}$/) ? hash : null;
}

function config_snapshot(path) {
    if (!editor_path_valid(path)) return { success: false, error: 'Unsupported configuration path' };
    const before = config_file_hash(path);
    if (!before) return { success: false, error: 'Configuration file missing or inaccessible' };
    const content = readfile(path);
    const after = config_file_hash(path);
    if (type(content) != 'string' || before != after || length(content) > 2097152)
        return { success: false, error: 'Configuration changed while reading or is too large' };
    return { success: true, content: content, revision: before };
}

function editor_tempdir() {
    const proc = popen('mktemp -d /tmp/nikki-rs-diff.XXXXXX');
    if (!proc) return null;
    const path = trim(proc.read('all'));
    proc.close();
    return index(path, '/tmp/nikki-rs-diff.') == 0 ? path : null;
}

function editor_write(path, content) {
    return type(content) == 'string' && writefile(path, content) != null;
}

function editor_read_limited(path, limit) {
    const content = readfile(path);
    if (type(content) != 'string' || length(content) > limit) return null;
    return content;
}

function editor_normalize_yaml(path) {
    const proc = popen("yq -P '... comments=\"\"' " + path);
    if (!proc) return false;
    const content = proc.read('all');
    proc.close();
    if (type(content) != 'string' || length(content) == 0 || length(content) > 2097152)
        return false;
    return writefile(path, content) != null;
}

function editor_active_profile() {
    const proc = popen('uci -q get nikki-rs.config.profile');
    if (!proc) return null;
    const value = trim(proc.read('all'));
    proc.close();
    let matched = match(value, /^file:([a-zA-Z0-9_.-]+\.(yaml|yml))$/);
    if (matched != null) return '/etc/nikki-rs/profiles/' + matched[1];
    matched = match(value, /^subscription:([a-zA-Z0-9_-]+)$/);
    if (matched != null) return '/etc/nikki-rs/subscriptions/' + matched[1] + '.yaml';
    return null;
}

function editor_preview_profile(source, output, mixin) {
    const args = ['/etc/init.d/nikki-rs', 'preview_profile', source, output];
    if (type(mixin) == 'string' && length(mixin) > 0) push(args, mixin);
    return system(args) == 0 && access(output, 'r');
}

function editor_override_preview(base, module, candidate, output) {
    let command = '/etc/nikki-rs/scripts/override-manager.sh preview ' + base;
    if (type(module) == 'string' && length(module) > 0)
        command += ' ' + module + ' ' + candidate;
    const proc = popen(command);
    if (!proc) return false;
    const content = proc.read('all');
    proc.close();
    if (type(content) != 'string' || length(content) == 0 || length(content) > 2097152)
        return false;
    return writefile(output, content) != null;
}

// Extract the ordered routing rules and rule provider names so the LuCI
// editor can render a structured rule diff instead of a raw YAML wall.
function editor_extract_rules(path) {
    const expr = '{"rules": (.rules // [] | map(tostring)), "rule_providers": (."rule-providers" // {} | keys)}';
    const proc = popen("yq -o=json -I=0 '" + expr + "' " + path);
    if (!proc) return null;
    const output = proc.read('all');
    proc.close();
    if (type(output) != 'string' || length(output) == 0 || length(output) > 2097152)
        return null;
    let data = null;
    try { data = json(output); } catch (e) { return null; }
    if (type(data) != 'object') return null;
    const rules = [];
    const list = type(data.rules) == 'array' ? data.rules : [];
    const providers = [];
    const plist = type(data.rule_providers) == 'array' ? data.rule_providers : [];
    let total = 0;
    let truncated = length(list) > 10000 || length(plist) > 1000;
    for (let i = 0; i < length(list); i++) {
        if (i >= 10000) { truncated = true; break; }
        let entry = type(list[i]) == 'string' ? list[i] : json(list[i]);
        if (type(entry) != 'string') entry = '';
        if (length(entry) > 512) {
            truncated = true;
            entry = substr(entry, 0, 509) + '...';
        }
        if (total + length(entry) > 262144) { truncated = true; break; }
        total += length(entry);
        push(rules, entry);
    }
    for (let i = 0; i < length(plist) && i < 1000; i++) {
        const name = type(plist[i]) == 'string' ? plist[i] : json(plist[i]);
        if (length(name) > 128) truncated = true;
        push(providers, substr(name, 0, 128));
    }
    return { rules: rules, rule_providers: providers, truncated: truncated,
        total_rules: length(list), total_rule_providers: length(plist) };
}

function profile_effective_diff() {
    const profile = editor_active_profile();
    if (!profile || !editor_path_valid(profile) || !access(profile, 'r'))
        return { success: false, error: 'Choose an existing profile in App Config before comparing.' };
    const source = editor_read_limited(profile, 2097152);
    if (source == null)
        return { success: false, error: 'The selected profile is missing or exceeds the 2 MiB limit.' };
    const dir = editor_tempdir();
    if (!dir)
        return { success: false, error: 'Unable to create a comparison workspace.' };
    const beforePath = dir + '/before.yaml';
    const afterPath = dir + '/after.yaml';
    let ok = editor_write(beforePath, source) && editor_preview_profile(profile, afterPath);
    if (ok)
        ok = editor_normalize_yaml(beforePath) && editor_normalize_yaml(afterPath);
    if (!ok) {
        system(['rm', '-rf', dir]);
        return { success: false, error: 'Could not compose the effective profile. Check the profile and Nikki RS log.' };
    }
    const before = editor_read_limited(beforePath, 1048576);
    const after = editor_read_limited(afterPath, 1048576);
    let rulesBefore = null;
    let rulesAfter = null;
    if (before != null && after != null) {
        rulesBefore = editor_extract_rules(beforePath);
        rulesAfter = editor_extract_rules(afterPath);
    }
    system(['rm', '-rf', dir]);
    if (before == null || after == null)
        return { success: false, error: 'The effective profile exceeds the 1 MiB display limit.' };
    return {
        success: true, before: before, after: after, mode: 'yaml',
        note: 'Compared the selected source profile with its effective output after applying current UCI mixin settings, mixin.yaml when enabled, Advanced Config overrides, and startup safety rules. This preview does not start or restart the service.',
        rules_before: rulesBefore, rules_after: rulesAfter
    };
}

function profile_rule_import() {
    const profile = editor_active_profile();
    if (!profile || !editor_path_valid(profile) || !access(profile, 'r'))
        return { success: false, error: 'Choose an existing profile in App Config before importing rules.' };
    const view = editor_extract_rules(profile);
    if (view == null)
        return { success: false, error: 'Could not extract rules from the selected profile.' };
    return {
        success: true, rules: view.rules, total_rules: view.total_rules,
        truncated: view.truncated
    };
}

const methods = {
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-nikki-rs | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-nikki-rs | cut -d " " -f 1 | cut -d "-" -f 5');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('if [ -x /etc/nikki-rs/core/clash-rs ]; then /etc/nikki-rs/core/clash-rs -v; else /usr/bin/clash-rs -v; fi');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			let profile = {};
			const defaults = req.args?.defaults ?? {};
			const filepath = '/etc/nikki-rs/run/config.yaml';
			const tmpFilepath = '/var/run/nikki-rs/profile.json';
			if (access(filepath, 'r')) {
				writefile(tmpFilepath, defaults);
				const command = `yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${filepath}`;
				const process = popen(command);
				if (process) {
					profile = json(process);
					process.close();
				}
			}
			return profile;
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			const section_id = req.args?.section_id;
			if (type(section_id) != 'string' || !match(section_id, /^[a-zA-Z0-9_]+$/))
				return { success: false, error: 'Invalid subscription section' };
			const command_ok = system(['service', 'nikki-rs', 'update_subscription', section_id]) == 0;
			const status_proc = popen('uci -q get nikki-rs.' + section_id + '.success');
			const status = status_proc ? trim(status_proc.read('all')) : '';
			if (status_proc) status_proc.close();
			const error_proc = popen('uci -q get nikki-rs.' + section_id + '.error');
			const error = error_proc ? trim(error_proc.read('all')) : '';
			if (error_proc) error_proc.close();
			return { success: command_ok && status == '1',
				error: error || (status == '1' ? '' : 'Update failed. Check Nikki RS logs for details.') };
		}
	},
	update_rule_provider: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id) {
				success = system(['service', 'nikki-rs', 'update_rule_provider', section_id]) == 0;
			} else {
				success = system(['service', 'nikki-rs', 'update_rule_provider']) == 0;
			}
			return { success: success };
		}
	},
	update_china_mainland_ip: {
		call: function() {
			const success = system(['service', 'nikki-rs', 'update_china_mainland_ip']) == 0;
			return { success: success };
		}
	},
	update_china_mainland_ip6: {
		call: function() {
			const success = system(['service', 'nikki-rs', 'update_china_mainland_ip6']) == 0;
			return { success: success };
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method;
			const path = req.args?.path;
			const query = req.args?.query;
			const body = req.args?.body;

			const profile = load_profile();
			const api_listen = profile['external-controller'];
			const api_secret = profile['secret'];
			if (!api_listen) {
				return result;
			}

			const url = api_listen + path;

			const process = popen(`curl --proto-default 'http' --insecure --request '${method}' --oauth2-bearer '${api_secret}' --url-query '${query}' --data '${body}' '${url}'`);
			if (process) {
				result = json(process);
				process.close();
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/nikki-rs') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},






    settings_read: {
        args: { module: 'module' },
        call: function(req) {
            const module = req.args?.module;
            if (!allowed_override_module(module) || module == 'proxy-groups' || module == 'rules')
                return { success: false, error: 'Unsupported form module' };
            const proc = popen('/etc/nikki-rs/scripts/settings-manager.sh read ' + module);
            if (!proc) return { success: false, error: 'Settings manager unavailable' };
            const output = trim(proc.read('all'));
            proc.close();
            if (length(output) < 2 || length(output) > 65536)
                return { success: false, error: 'Unable to load settings' };
            try {
                const parsed = json(output);
                if (type(parsed.fields) != 'array' || type(parsed.values) != 'object' ||
                    !match(parsed.revision, /^[0-9a-f]{64}$/))
                    return { success: false, error: 'Invalid settings response' };
                return { success: true, fields: parsed.fields, values: parsed.values,
                    revision: parsed.revision };
            } catch (e) {
                return { success: false, error: 'Settings parsing failed' };
            }
        }
    },
    settings_draft: {
        args: { module: 'module', content: 'content', revision: 'revision' },
        call: function(req) {
            const module = req.args?.module;
            const revision = req.args?.revision;
            if (!allowed_override_module(module) || module == 'proxy-groups' ||
                module == 'rules' || type(revision) != 'string' ||
                !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, error: 'Invalid settings request' };
            // Optimistic revision check before generating a draft.
            const path = '/etc/nikki-rs/overrides/' + module + '.yaml';
            if (config_file_hash(path) != revision)
                return { success: false, error: 'This module changed on disk. Reload before preview.' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid patch' };
            const proc = popen('/etc/nikki-rs/scripts/settings-manager.sh draft ' +
                module + ' ' + stage + ' ' + revision);
            if (!proc) {
                unlink(stage);
                return { success: false, error: 'Settings manager unavailable' };
            }
            const draft = proc.read('all');
            proc.close();
            unlink(stage);
            if (length(draft) < 2 || length(draft) > 262144)
                return { success: false, error: 'Could not construct a valid YAML draft' };
            return { success: true, content: draft };
        }
    },
    settings_patch: {
        args: { module: 'module', content: 'content', revision: 'revision' },
        call: function(req) {
            const module = req.args?.module;
            const revision = req.args?.revision;
            if (!allowed_override_module(module) || module == 'proxy-groups' ||
                module == 'rules' || type(revision) != 'string' ||
                !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, error: 'Invalid module or revision' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid or oversized patch' };
            const proc = popen('/etc/nikki-rs/scripts/settings-manager.sh patch ' +
                module + ' ' + stage + ' ' + revision);
            if (!proc) {
                unlink(stage);
                return { success: false, error: 'Settings manager unavailable' };
            }
            const output = trim(proc.read('all'));
            proc.close();
            unlink(stage);
            try {
                const result = json(output);
                if (result.success === true && match(result.revision, /^[0-9a-f]{64}$/))
                    return { success: true, revision: result.revision };
            } catch (e) {}
            return { success: false, error: 'Settings validation failed or the module changed. Reload before saving.' };
        }
    },
    config_snapshot: {
        args: { path: 'path' },
        call: function(req) {
            return config_snapshot(req.args?.path);
        }
    },
    save_config_revision: {
        args: { path: 'path', content: 'content', revision: 'revision' },
        call: function(req) {
            const path = req.args?.path;
            const revision = req.args?.revision;
            if (!editor_path_valid(path) || type(revision) != 'string' ||
                !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, error: 'Invalid file or expected revision' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid or oversized content' };
            const success = system(['/etc/nikki-rs/scripts/config-manager.sh',
                'save-revision', path, stage, revision]) == 0;
            unlink(stage);
            return { success: success, error: success ? '' : 'Save blocked: invalid YAML, concurrent edit, or filesystem error. Reload before retrying.' };
        }
    },
    collection_read: {
        args: { module: 'module' },
        call: function(req) {
            const module = req.args?.module;
            if (index(['proxy-groups', 'listeners', 'rule-providers', 'proxy-providers'], module) < 0)
                return { success: false, error: 'Unsupported collection module' };
            const proc = popen('/etc/nikki-rs/scripts/collections-manager.sh read ' + module);
            if (!proc) return { success: false, error: 'Collection manager is unavailable' };
            const output = proc.read('all');
            proc.close();
            if (length(output) < 2 || length(output) > 300000)
                return { success: false, error: 'Collection read failed or too large' };
            try {
                const data = json(output);
                if (type(data.revision) != 'string' ||
                    !match(data.revision, /^[0-9a-f]{64}$/) ||
                    (type(data.items) != 'array' && type(data.items) != 'object'))
                    return { success: false, error: 'Unexpected collection data' };
                return { success: true, items: data.items, revision: data.revision };
            } catch (e) {
                return { success: false, error: 'Invalid collection data' };
            }
        }
    },
    collection_write: {
        args: { module: 'module', content: 'content', revision: 'revision', draft: 'draft' },
        call: function(req) {
            const module = req.args?.module;
            const revision = req.args?.revision;
            const mode = req.args?.draft === true ? 'draft' : 'save';
            if (index(['proxy-groups', 'listeners', 'rule-providers', 'proxy-providers'], module) < 0 ||
                type(revision) != 'string' || !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, error: 'Invalid collection module or revision' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid or oversized collection' };
            const proc = popen('/etc/nikki-rs/scripts/collections-manager.sh ' +
                mode + ' ' + module + ' ' + stage + ' ' + revision);
            if (!proc) {
                unlink(stage);
                return { success: false, error: 'Collection manager is unavailable' };
            }
            const output = proc.read('all');
            proc.close();
            unlink(stage);
            if (length(output) > 262144)
                return { success: false, error: 'Collection output too large' };
            if (mode == 'draft')
                return length(output) > 1 ? { success: true, content: output } :
                    { success: false, error: 'Could not generate a valid collection draft' };
            try {
                const data = json(output);
                if (data.success === true && match(data.revision, /^[0-9a-f]{64}$/))
                    return { success: true, revision: data.revision };
            } catch (e) {}
            return { success: false, error: 'Collection validation failed or file changed. Reload before saving.' };
        }
    },
    rule_list: {
        call: function() {
            const proc = popen('/etc/nikki-rs/scripts/rules-manager.sh list');
            if (!proc) return { success: false, error: 'Could not read rules' };
            const output = trim(proc.read('all'));
            proc.close();
            try {
                const result = json(output);
                return { success: true, revision: result.revision, rules: result.rules };
            } catch (e) {
                return { success: false, error: 'Invalid rules module; open the YAML editor to repair it' };
            }
        }
    },
    rule_save: {
        args: { content: 'content', revision: 'revision' },
        call: function(req) {
            const revision = req.args?.revision;
            if (type(revision) != 'string' || !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, error: 'Invalid revision' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid or oversized rule payload' };
            const result = system(['/etc/nikki-rs/scripts/rules-manager.sh', 'save', stage, revision]) == 0;
            unlink(stage);
            return { success: result, error: result ? '' : 'Save rejected: invalid rules, concurrent edits, or filesystem error. Reload the rule list before retrying.' };
        }
    },
    override_analyze: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            const module = req.args?.module;
            if (!allowed_override_module(module))
                return { success: false, error: 'Unknown configuration module' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage)
                return { success: false, error: 'Invalid or oversized candidate' };
            const base = '/etc/nikki-rs/run/base.yaml';
            if (!access(base, 'r')) {
                unlink(stage);
                return { success: false, error: 'Start Nikki RS first to generate a base profile' };
            }
            // Only the checked module name and server-generated random path are
            // passed to the command. Never return merged YAML or credentials.
            const proc = popen('/etc/nikki-rs/scripts/config-analyzer.sh ' +
                base + ' ' + module + ' ' + stage);
            if (!proc) {
                unlink(stage);
                return { success: false, error: 'Unable to analyze configuration' };
            }
            const output = trim(proc.read('all'));
            proc.close();
            unlink(stage);
            if (length(output) == 0 || length(output) > 8192)
                return { success: false, error: 'Configuration analysis failed' };
            try {
                const data = json(output);
                if (type(data) != 'object' || type(data.changed_sections) != 'array' ||
                    type(data.before) != 'object' || type(data.after) != 'object')
                    return { success: false, error: 'Invalid analysis response' };
                return { success: true, report: data };
            } catch (e) {
                return { success: false, error: 'Configuration analysis failed' };
            }
        }
    },
    config_apply: {
        args: { module: 'module', content: 'content', revision: 'revision' },
        call: function(req) {
            const module = req.args?.module;
            const revision = req.args?.revision;
            if (!allowed_override_module(module) || type(revision) != 'string' ||
                !match(revision, /^[0-9a-f]{64}$/))
                return { success: false, status: 'INVALID_REQUEST' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, status: 'INVALID_CANDIDATE' };
            const proc = popen('/etc/nikki-rs/scripts/config-apply.sh apply ' +
                module + ' ' + stage + ' ' + revision);
            if (!proc) {
                unlink(stage);
                return { success: false, status: 'UNAVAILABLE' };
            }
            const status = trim(proc.read('all'));
            proc.close();
            unlink(stage);
            // The CLI emits only fixed status tokens, never profile contents.
            if (status == 'APPLIED') return { success: true, status: 'APPLIED' };
            if (index(status, 'ROLLBACK_FAILED') >= 0)
                return { success: false, status: 'ROLLBACK_FAILED' };
            if (index(status, 'ROLLED_BACK') >= 0)
                return { success: false, status: 'ROLLED_BACK' };
            const codes = [
                'INVALID_REQUEST', 'INVALID_MODULE', 'INVALID_CANDIDATE',
                'INVALID_REVISION', 'INVALID_WAIT', 'MODULE_UNAVAILABLE',
                'BASE_UNAVAILABLE', 'SERVICE_UNAVAILABLE', 'APPLY_BUSY',
                'STAGING_FAILED', 'CONFLICT', 'SERVICE_NOT_RUNNING',
                'PREFLIGHT_FAILED', 'SAVE_FAILED', 'RESTART_FAILED',
                'HEALTHCHECK_FAILED'
            ];
            return { success: false, status: index(codes, status) >= 0 ? status : 'FAILED' };
        }
    },
    override_test: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            const module = req.args?.module;
            if (!allowed_override_module(module)) return { success: false, error: 'Unknown module' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid or oversized candidate' };
            const base = '/etc/nikki-rs/run/base.yaml';
            if (!access(base, 'r')) {
                unlink(stage);
                return { success: false, error: 'Start Nikki RS once to generate the base profile' };
            }
            const success = system(['/etc/nikki-rs/scripts/override-manager.sh',
                'test', base, module, stage]) == 0;
            unlink(stage);
            return { success: success, error: success ? '' : 'The core rejected the merged profile or provider initialization timed out' };
        }
    },
    override_inspect: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            const module = req.args?.module;
            if (!allowed_override_module(module)) return { success: false, error: 'Unknown module' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid content' };
            const base = '/etc/nikki-rs/run/base.yaml';
            if (!access(base, 'r')) {
                unlink(stage);
                return { success: false, error: 'Generate a base profile by starting Nikki RS first' };
            }
            const manager = '/etc/nikki-rs/scripts/override-manager.sh';
            if (system([manager, 'check', base, module, stage]) != 0) {
                unlink(stage);
                return { success: false, error: 'Merge failed; inspect the YAML mapping' };
            }
            const process = popen(manager + ' inspect ' + base + ' ' + module + ' ' + stage);
            if (!process) {
                unlink(stage);
                return { success: false, error: 'Cannot inspect merged configuration' };
            }
            const info = trim(process.read('all'));
            process.close();
            unlink(stage);
            return { success: length(info) > 0 && length(info) < 4096, info: info };
        }
    },
    override_preview: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            const result = override_preview(req.args?.module, req.args?.content);
            if (!result.success) return result;
            const rulesPath = staged_editor_content(result.content);
            result.rules = rulesPath ? editor_extract_rules(rulesPath) : null;
            if (rulesPath) unlink(rulesPath);
            return result;
        }
    },
    core_status: {
        call: function() {
            const proc = popen('/etc/nikki-rs/scripts/core-manager.sh status');
            if (!proc) return { info: 'Core status unavailable' };
            const info = trim(proc.read('all'));
            proc.close();
            return { info: info };
        }
    },
    core_update: {
        args: { variant: 'variant', tag: 'tag' },
        call: function(req) {
            const variant = req.args?.variant ?? 'minimal';
            const tag = req.args?.tag ?? 'latest';
            if (variant != 'minimal' && variant != 'standard') return { success: false };
            return { success: system(['/etc/nikki-rs/scripts/core-manager.sh', 'update', variant, tag]) == 0 };
        }
    },
    core_rollback: {
        call: function() {
            return { success: system(['/etc/nikki-rs/scripts/core-manager.sh', 'rollback']) == 0 };
        }
    },
    validate_config: {
        args: { path: 'path', content: 'content' },
        call: function(req) {
            return editor_operation('validate', req.args?.path, req.args?.content);
        }
    },
    editor_diff: {
        args: { path: 'path', content: 'content' },
        call: function(req) {
          try {
            const path = req.args?.path;
            if (!editor_path_valid(path))
                return { success: false, error: 'Unsupported configuration path' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage)
                return { success: false, error: 'Invalid or oversized content' };
            const dir = editor_tempdir();
            if (!dir) {
                unlink(stage);
                return { success: false, error: 'Unable to create a comparison workspace' };
            }
            const beforePath = dir + '/before';
            const afterPath = dir + '/after';
            const relative = substr(path, length('/etc/nikki-rs/'));
            let mode = 'yaml';
            let note = '';
            let ok = false;

            if (path == '/etc/nikki-rs/run/config.yaml') {
                ok = editor_write(beforePath, readfile(path)) &&
                     editor_write(afterPath, readfile(stage));
                note = 'Compares the saved startup profile with the editor content. Nikki RS regenerates this file on restart.';
            }
            else if (relative == 'mixin.yaml') {
                const profile = editor_active_profile();
                const proc = popen('uci -q get nikki-rs.mixin.mixin_file_content');
                const enabled = proc ? trim(proc.read('all')) == '1' : false;
                if (proc) proc.close();
                if (!profile || !access(profile, 'r')) {
                    system(['rm', '-rf', dir]);
                    unlink(stage);
                    return { success: false, error: 'The active profile is missing; start Nikki RS once first' };
                }
                ok = editor_preview_profile(profile, beforePath) &&
                     editor_preview_profile(profile, afterPath, stage);
                note = enabled ?
                    'Compares the effective configuration from the saved mixin with the editor content.' :
                    'The mixin file is not applied while "Use mixin file content" is disabled.';
            }
            else if (match(relative, /^(profiles|subscriptions)\/[a-zA-Z0-9_.-]+\.(yaml|yml)$/) != null) {
                ok = editor_preview_profile(path, beforePath) &&
                     editor_preview_profile(stage, afterPath);
                note = 'Compares the effective configuration from the saved file with the editor content.';
            }
            else if (match(relative, /^overrides\/([a-z-]+)\.yaml$/) != null) {
                const module = match(relative, /^overrides\/([a-z-]+)\.yaml$/)[1];
                const base = '/etc/nikki-rs/run/base.yaml';
                if (!access(base, 'r')) {
                    system(['rm', '-rf', dir]);
                    unlink(stage);
                    return { success: false, error: 'Start Nikki RS once to generate the base profile used for comparison' };
                }
                ok = editor_override_preview(base, null, null, beforePath) &&
                     editor_override_preview(base, module, stage, afterPath);
                note = 'Compares the current merged configuration with the same merge using this module candidate. The base profile is from the last Nikki RS start.';
            }
            else {
                mode = 'text';
                ok = editor_write(beforePath, readfile(path)) &&
                     editor_write(afterPath, readfile(stage));
                note = 'Compares the saved file with the editor content.';
            }

            unlink(stage);
            if (!ok) {
                system(['rm', '-rf', dir]);
                return { success: false, error: 'Could not compose the comparison. Check YAML syntax and the Nikki RS log.' };
            }
            if (mode == 'yaml' && (!editor_normalize_yaml(beforePath) ||
                                   !editor_normalize_yaml(afterPath))) {
                system(['rm', '-rf', dir]);
                return { success: false, error: 'Could not normalize YAML for comparison' };
            }
            const before = editor_read_limited(beforePath, 1048576);
            const after = editor_read_limited(afterPath, 1048576);
            let rulesBefore = null;
            let rulesAfter = null;
            if (mode == 'yaml' && before != null && after != null) {
                rulesBefore = editor_extract_rules(beforePath);
                rulesAfter = editor_extract_rules(afterPath);
            }
            system(['rm', '-rf', dir]);
            if (before == null || after == null)
                return { success: false, error: 'The comparison exceeds the 1 MiB display limit' };
            return { success: true, before: before, after: after, mode: mode, note: note,
                rules_before: rulesBefore, rules_after: rulesAfter };
          } catch (e) {
            return { success: false, error: 'Comparison failed unexpectedly' };
          }
        }
    },
    profile_effective_diff: {
        call: function() {
            return profile_effective_diff();
        }
    },
    profile_rule_import: {
        call: function() {
            return profile_rule_import();
        }
    },
    save_config: {
        args: { path: 'path', content: 'content' },
        call: function(req) {
            return editor_operation('save', req.args?.path, req.args?.content);
        }
    },
    list_config_backups: {
        args: { path: 'path' },
        call: function(req) {
            const path = req.args?.path;
            if (!editor_path_valid(path)) return { backups: [] };
            const proc = popen('/etc/nikki-rs/scripts/config-manager.sh backups ' + path);
            if (!proc) return { backups: [] };
            const output = trim(proc.read('all'));
            proc.close();
            return { backups: output ? split(output, '\n') : [] };
        }
    },
    restore_config: {
        args: { path: 'path', backup: 'backup' },
        call: function(req) {
            const path = req.args?.path;
            const backup = req.args?.backup;
            if (!editor_path_valid(path) || type(backup) != 'string') return { success: false };
            return { success: system(['/etc/nikki-rs/scripts/config-manager.sh', 'restore', path, backup]) == 0 };
        }
    },
	debug: {
		call: function() {
			const success = system('/etc/nikki-rs/scripts/debug.sh > /var/log/nikki-rs/debug.log') == 0;
			return { success: success };
		}
	}
};

return { 'luci.nikki-rs': methods };