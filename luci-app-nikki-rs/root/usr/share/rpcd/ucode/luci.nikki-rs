#!/usr/bin/ucode

'use strict';

import { access, popen, writefile, unlink } from 'fs';
import { get_users, get_groups, get_cgroups, load_profile } from '/etc/nikki-rs/ucode/include.uc';


function editor_path_valid(path) {
    if (type(path) != 'string') return false;
    const base = '/etc/nikki-rs/';
    if (index(path, base) != 0 || index(path, '..') >= 0 ||
        index(path, "'") >= 0 || index(path, ' ') >= 0 ||
        index(path, ';') >= 0 || index(path, '|') >= 0 ||
        index(path, '\\') >= 0) return false;
    const relative = substr(path, length(base));
    const overrideModule = match(relative, /^overrides\/([a-z-]+)\.yaml$/);
    if (overrideModule != null) return allowed_override_module(overrideModule[1]);
    const fixed = [
        'mixin.yaml', 'run/config.yaml',
        'dns/black_filter', 'dns/fake_ip_filter', 'dns/fallback_filter',
        'nftables/proxy_whitelist.txt', 'nftables/proxy_whitelist6.txt'
    ];
    if (index(fixed, relative) >= 0) return true;
    const parts = split(relative, '/');
    if (length(parts) != 2 || (parts[0] != 'profiles' && parts[0] != 'subscriptions')) return false;
    return match(parts[1], /^[a-zA-Z0-9_.-]+\.(yaml|yml)$/) != null;
}

function staged_editor_content(content) {
    if (type(content) != 'string' || length(content) > 2097152) return null;
    const process = popen('mktemp /tmp/nikki-rs-edit.XXXXXX');
    if (!process) return null;
    const path = trim(process.read('all'));
    process.close();
    if (index(path, '/tmp/nikki-rs-edit.') != 0) return null;
    if (writefile(path, content) == null) {
        unlink(path);
        return null;
    }
    return path;
}

function editor_operation(action, path, content) {
    if (!editor_path_valid(path)) return { success: false, error: 'Invalid editor path' };
    const staged = staged_editor_content(content);
    if (!staged) return { success: false, error: 'Invalid or oversized content' };
    const success = system(['/etc/nikki-rs/scripts/config-manager.sh', action, path, staged]) == 0;
    unlink(staged);
    return { success: success, error: success ? '' : 'Configuration validation or file operation failed' };
}


function allowed_override_module(module) {
    if (type(module) != 'string') return false;
    return index(['general', 'dns', 'proxy-groups', 'rules', 'tun', 'sniffer', 'custom'], module) >= 0;
}

function override_preview(module, content) {
    if (!allowed_override_module(module)) return { success: false, error: 'Unknown module' };
    const stage = staged_editor_content(content);
    if (!stage) return { success: false, error: 'Invalid or oversized YAML' };
    const base = '/etc/nikki-rs/run/base.yaml';
    if (!access(base, 'r')) {
        unlink(stage);
        return { success: false, error: 'No generated base configuration yet; start Nikki RS to generate it' };
    }
    const manager = '/etc/nikki-rs/scripts/override-manager.sh';
    const valid = system([manager, 'check', base, module, stage]) == 0;
    if (!valid) {
        unlink(stage);
        return { success: false, error: 'YAML invalid or merge failed. Check structure and module content' };
    }
    const proc = popen(manager + ' preview ' + base + ' ' + module + ' ' + stage);
    if (!proc) {
        unlink(stage);
        return { success: false, error: 'Failed to create a merged preview' };
    }
    const output = proc.read('all');
    proc.close();
    unlink(stage);
    if (length(output) > 1048576)
        return { success: false, error: 'Merged YAML exceeds 1 MiB preview limit; inspect generated config on the router' };
    return { success: length(output) > 0, content: output };
}

const methods = {
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-nikki-rs | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-nikki-rs | cut -d " " -f 1 | cut -d "-" -f 5');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('if [ -x /etc/nikki-rs/core/clash-rs ]; then /etc/nikki-rs/core/clash-rs -v; else /usr/bin/clash-rs -v; fi');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			let profile = {};
			const defaults = req.args?.defaults ?? {};
			const filepath = '/etc/nikki-rs/run/config.yaml';
			const tmpFilepath = '/var/run/nikki-rs/profile.json';
			if (access(filepath, 'r')) {
				writefile(tmpFilepath, defaults);
				const command = `yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${filepath}`;
				const process = popen(command);
				if (process) {
					profile = json(process);
					process.close();
				}
			}
			return profile;
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id) {
				success = system(['service', 'nikki-rs', 'update_subscription', section_id]) == 0;
			}
			return { success: success };
		}
	},
	update_rule_provider: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id) {
				success = system(['service', 'nikki-rs', 'update_rule_provider', section_id]) == 0;
			} else {
				success = system(['service', 'nikki-rs', 'update_rule_provider']) == 0;
			}
			return { success: success };
		}
	},
	update_china_mainland_ip: {
		call: function() {
			const success = system(['service', 'nikki-rs', 'update_china_mainland_ip']) == 0;
			return { success: success };
		}
	},
	update_china_mainland_ip6: {
		call: function() {
			const success = system(['service', 'nikki-rs', 'update_china_mainland_ip6']) == 0;
			return { success: success };
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method;
			const path = req.args?.path;
			const query = req.args?.query;
			const body = req.args?.body;

			const profile = load_profile();
			const api_listen = profile['external-controller'];
			const api_secret = profile['secret'];
			if (!api_listen) {
				return result;
			}

			const url = api_listen + path;

			const process = popen(`curl --proto-default 'http' --insecure --request '${method}' --oauth2-bearer '${api_secret}' --url-query '${query}' --data '${body}' '${url}'`);
			if (process) {
				result = json(process);
				process.close();
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/nikki-rs') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},



    override_inspect: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            const module = req.args?.module;
            if (!allowed_override_module(module)) return { success: false, error: 'Unknown module' };
            const stage = staged_editor_content(req.args?.content);
            if (!stage) return { success: false, error: 'Invalid content' };
            const base = '/etc/nikki-rs/run/base.yaml';
            if (!access(base, 'r')) {
                unlink(stage);
                return { success: false, error: 'Generate a base profile by starting Nikki RS first' };
            }
            const manager = '/etc/nikki-rs/scripts/override-manager.sh';
            if (system([manager, 'check', base, module, stage]) != 0) {
                unlink(stage);
                return { success: false, error: 'Merge failed; inspect the YAML mapping' };
            }
            const process = popen(manager + ' inspect ' + base + ' ' + module + ' ' + stage);
            if (!process) {
                unlink(stage);
                return { success: false, error: 'Cannot inspect merged configuration' };
            }
            const info = trim(process.read('all'));
            process.close();
            unlink(stage);
            return { success: length(info) > 0 && length(info) < 4096, info: info };
        }
    },
    override_preview: {
        args: { module: 'module', content: 'content' },
        call: function(req) {
            return override_preview(req.args?.module, req.args?.content);
        }
    },
    core_status: {
        call: function() {
            const proc = popen('/etc/nikki-rs/scripts/core-manager.sh status');
            if (!proc) return { info: 'Core status unavailable' };
            const info = trim(proc.read('all'));
            proc.close();
            return { info: info };
        }
    },
    core_update: {
        args: { variant: 'variant', tag: 'tag' },
        call: function(req) {
            const variant = req.args?.variant ?? 'minimal';
            const tag = req.args?.tag ?? 'latest';
            if (variant != 'minimal' && variant != 'standard') return { success: false };
            return { success: system(['/etc/nikki-rs/scripts/core-manager.sh', 'update', variant, tag]) == 0 };
        }
    },
    core_rollback: {
        call: function() {
            return { success: system(['/etc/nikki-rs/scripts/core-manager.sh', 'rollback']) == 0 };
        }
    },
    validate_config: {
        args: { path: 'path', content: 'content' },
        call: function(req) {
            return editor_operation('validate', req.args?.path, req.args?.content);
        }
    },
    save_config: {
        args: { path: 'path', content: 'content' },
        call: function(req) {
            return editor_operation('save', req.args?.path, req.args?.content);
        }
    },
    list_config_backups: {
        args: { path: 'path' },
        call: function(req) {
            const path = req.args?.path;
            if (!editor_path_valid(path)) return { backups: [] };
            const proc = popen('/etc/nikki-rs/scripts/config-manager.sh backups ' + path);
            if (!proc) return { backups: [] };
            const output = trim(proc.read('all'));
            proc.close();
            return { backups: output ? split(output, '\n') : [] };
        }
    },
    restore_config: {
        args: { path: 'path', backup: 'backup' },
        call: function(req) {
            const path = req.args?.path;
            const backup = req.args?.backup;
            if (!editor_path_valid(path) || type(backup) != 'string') return { success: false };
            return { success: system(['/etc/nikki-rs/scripts/config-manager.sh', 'restore', path, backup]) == 0 };
        }
    },
	debug: {
		call: function() {
			const success = system('/etc/nikki-rs/scripts/debug.sh > /var/log/nikki-rs/debug.log') == 0;
			return { success: success };
		}
	}
};

return { 'luci.nikki-rs': methods };