msgstr "目標 IP 白名單：若設定，僅代理存取這些目標 IP 或 CIDR 網段的流量"

msgid "Bypass Destination IPs / CIDRs"
msgstr "直連目標 IP / 網段"

msgid "Destination IPs, CIDRs or reserved ranges to bypass directly (e.g. 127.0.0.0/8, 169.254.0.0/16, ::1/128)."
msgstr "直接直連的目標 IP、CIDR 或保留位址範圍（例如 127.0.0.0/8, 169.254.0.0/16, ::1/128）"

msgid "Proxy Destination Ports"
msgstr "代理目標連接埠"

msgid "Destination ports to proxy (if set, ONLY traffic to these ports will be proxied)."
msgstr "指定要代理的目標連接埠（若設定，僅代理存取這些目標連接埠的流量）"

msgid "Bypass Destination Ports"
msgstr "直連目標連接埠"

msgid "Destination ports to bypass directly (e.g. 123, 500, 4500)."
msgstr "直接直連的目標連接埠（例如 123, 500, 4500）"

