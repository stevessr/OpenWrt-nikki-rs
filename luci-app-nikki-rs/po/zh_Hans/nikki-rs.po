msgid "eBPF Config"
msgstr "eBPF 配置"

msgid "LAN Interface"
msgstr "入站绑定"

msgid "LAN interfaces to attach eBPF ingress filter."
msgstr "绑定 eBPF 入站过滤的局域网接口"

msgid "WAN Interface"
msgstr "出站绑定"

msgid "WAN interface to attach eBPF egress filter."
msgstr "绑定 eBPF 出站过滤的外网接口"

msgid "Transparent proxy port inside daens."
msgstr "daens 内部的透明代理端口"

msgid "Auto Direct Offload"
msgstr "自动直连卸载"

msgid "Automatically offload DIRECT traffic to eBPF dynamic bypass map."
msgstr "自动将直连ip下发至 eBPF使直连流量不经过代理"

msgid "Proxy Client IPs / CIDRs"
msgstr "代理客户端 IP / 网段"

msgid "Specific LAN client IPs or CIDRs to proxy (if empty, all clients except bypassed ones will be proxied)."
msgstr "指定要代理的局域网客户端 IP 或 CIDR 网段（若留空，则代理除直连列表外的所有客户端）"

msgid "Proxy Client MACs"
msgstr "代理客户端 MAC 地址"

msgid "Specific LAN client MAC addresses to proxy (if set, ONLY traffic from these MACs will be proxied)."
msgstr "指定要代理的局域网客户端 MAC 地址（若设置，仅代理来自这些 MAC 地址的客户端流量）"

msgid "Bypass Client IPs / CIDRs"
msgstr "直连客户端 IP / 网段"

msgid "Specific LAN client IPs or CIDRs to bypass directly (direct connection, no proxy)."
msgstr "指定直连（不代理）的局域网客户端 IP 或 CIDR 网段"

msgid "Proxy Source Ports"
msgstr "代理客户端源端口"

msgid "Source ports to proxy (if set, ONLY traffic from these source ports will be proxied)."
msgstr "指定要代理的客户端源端口（若设置，仅代理来自这些源端口的流量）"

msgid "Bypass Source Ports"
msgstr "直连客户端源端口"

msgid "Source ports to bypass (e.g. 22, 67, 68, 5353)."
msgstr "要直连的源端口（例如 22, 67, 68, 5353）"

msgid "Proxy Router Traffic"
msgstr "代理路由器本机流量"

msgid "Proxy traffic originating from the local router/gateway."
msgstr "代理路由器/网关自身发出的流量"

msgid "Proxy Processes"
msgstr "代理进程白名单"

msgid "Process whitelist: ONLY traffic originating from these process names will be proxied on the router."
msgstr "进程白名单：仅代理路由器上这些进程名称产生的流量"

msgid "Bypass Processes"
msgstr "直连进程黑名单"

msgid "Process blacklist: Traffic originating from these process names will always bypass proxy."
msgstr "进程黑名单：这些进程名称产生的流量始终直连放行"

msgid "WAN Proxy"
msgstr "公网代理"

msgid "Proxy Destination IPs / CIDRs"
msgstr "代理目标 IP / 网段"

msgid "Destination IP whitelist: if set, ONLY traffic to matching IPs/CIDRs will be proxied."
msgstr "目标 IP 白名单：若设置，仅代理访问这些目标 IP 或 CIDR 网段的流量"

msgid "Bypass Destination IPs / CIDRs"
msgstr "直连目标 IP / 网段"

msgid "Destination IPs, CIDRs or reserved ranges to bypass directly (e.g. 127.0.0.0/8, 169.254.0.0/16, ::1/128)."
msgstr "直接直连的目标 IP、CIDR 或保留地址范围（例如 127.0.0.0/8, 169.254.0.0/16, ::1/128）"

msgid "Proxy Destination Ports"
msgstr "代理目标端口"

msgid "Destination ports to proxy (if set, ONLY traffic to these ports will be proxied)."
msgstr "指定要代理的目标端口（若设置，仅代理访问这些目标端口的流量）"

msgid "Bypass Destination Ports"
msgstr "直连目标端口"

msgid "Destination ports to bypass directly (e.g. 123, 500, 4500)."
msgstr "直接直连的目标端口（例如 123, 500, 4500）"

msgid "Traffic with matching DSCP (0-63) values will bypass proxy directly."
msgstr "匹配指定 DSCP (0-63) 的流量将直接绕过代理"

msgid "Traffic with matching firewall mark (e.g. 0x200 or 512) will bypass proxy directly."
msgstr "匹配指定防火墙标记 (如 0x200 或 512) 的流量将直接绕过代理"

msgid "Expecting a valid decimal (0-4294967295) or hex (0x0-0xffffffff) fwmark"
msgstr "请输入有效的十进制 (0-4294967295) 或十六进制 (0x0-0xffffffff) 防火墙标记"

msgid "When enabled, the Proxy Config will be ineffective."
msgstr "本功能开启后代理配置将失效"

msgid "Allow QUIC"
msgstr "放行 QUIC"

msgid "Allow QUIC traffic (UDP port 443). When disabled, QUIC packets are dropped to force fallback to TCP."
msgstr "允许代理放行 QUIC 流量（UDP 443 端口）。禁用时将丢弃 QUIC 数据包以强制回退到 TCP。"


msgid "DNS2 Config"
msgstr "DNS2 配置"

msgid "Enable DNS2"
msgstr "启用 DNS2"

msgid "Domestic and LAN domains use domestic DNS and return real IPs. Other domains use the foreign DNS mode. DNS2 takes priority over legacy DNS."
msgstr "国内及局域网域名使用国内 DNS，返回真实 IP；其余域名使用国外解析模式。启用后优先于原 DNS 配置。"

msgid "Domestic DNS"
msgstr "国内 DNS"

msgid "Supports IP addresses and udp://, tcp://, tls:// or https:// addresses. Always connects directly and returns real IPs."
msgstr "支持 IP 地址及 udp://、tcp://、tls://、https:// 地址。始终直连解析并返回真实 IP。"

msgid "Foreign DNS mode"
msgstr "国外 DNS 类型"

msgid "Real IP"
msgstr "真实 IP"

msgid "Foreign DNS"
msgstr "国外 DNS"

msgid "Foreign DNS outbound"
msgstr "国外 DNS 出站"

msgid "Use DIRECT or an existing proxy group or node name. In Fake IP mode, the proxy resolves domains when connecting."
msgstr "填写 DIRECT 或已有的代理组、节点名称。Fake IP 模式由代理在建立连接时解析域名。"

msgid "Resolve IPv6"
msgstr "解析 IPv6"

msgid "Listen address"
msgstr "监听地址"

msgid "DNS2 takes priority over legacy DNS. Configure upstreams and ordered routing rules below."
msgstr "DNS2 优先于原 DNS 配置。请在下方配置上游及有序分流规则。"

msgid "Hosts files"
msgstr "Hosts 文件"

msgid "Bootstrap DNS"
msgstr "引导 DNS"

msgid "Proxy Server Nameserver"
msgstr "节点域名 DNS"

msgid "Domestic DNS always connects directly and returns real IPs."
msgstr "国内 DNS 始终直连解析并返回真实 IP。"

msgid "Optimistic cache TTL"
msgstr "乐观缓存最小 TTL"

msgid "Stale cache retention"
msgstr "过期缓存保留时间"

msgid "Cache capacity"
msgstr "缓存容量"

msgid "DNS2 routing rules"
msgstr "DNS2 分流规则"

msgid "Rules match from top to bottom; first match wins. Drag rows to change priority. Fake IP is only a foreign-domain target; place domestic exceptions above it."
msgstr "规则从上到下匹配，首条命中生效，可拖动调整顺序。Fake IP 仅用于国外域名，请将国内例外规则置于其前。"

msgid "Query type"
msgstr "查询类型"

msgid "Source IP"
msgstr "来源 IP"

msgid "Rule set names must not be empty."
msgstr "规则集名称不能为空。"

msgid "Resolve DNS"
msgstr "解析 DNS"

msgid "Foreign Fake IP"
msgstr "国外 Fake IP"

msgid "Reject"
msgstr "拒绝"

msgid "Invert match"
msgstr "反向匹配"

msgid "Reject response"
msgstr "拒绝响应"

msgid "Unmatched domains"
msgstr "未匹配域名"

msgid "Used only after every enabled routing rule has been checked."
msgstr "仅在所有启用的分流规则均未命中时使用。"

msgid "Fake IP"
msgstr "虚拟 IP（Fake IP）"

msgid "Rules match from top to bottom; first match wins. Drag rows to change priority. Foreign DNS follows the selected Fake IP or Real IP setting. Domestic DNS always returns real IPs."
msgstr "规则从上到下匹配，首条命中生效，可拖动调整顺序。国外 DNS 使用所选的 Fake IP 或真实 IP 类型，国内 DNS 始终返回真实 IP。"

msgid "Combine conditions in one rule: (domain OR rule set) AND query type AND source IP. Empty conditions are ignored. Values within each condition use OR. At least one condition is required."
msgstr "一条规则可组合多种条件：（域名或规则集）且查询类型且来源 IP。空条件不参与判断，同类多个值之间为“或”。至少填写一种条件。"

msgid "At least one matching condition is required."
msgstr "请至少填写一种匹配条件。"

msgid "Basic settings"
msgstr "基础设置"

msgid "DNS upstreams"
msgstr "DNS 上游"

msgid "Hosts settings"
msgstr "Hosts 设置"

msgid "Cache settings"
msgstr "缓存设置"

msgid "Routing settings"
msgstr "分流设置"

msgid "Domestic DNS client subnet"
msgstr "国内 DNS 客户端子网"

msgid "Foreign DNS client subnet"
msgstr "国外 DNS 客户端子网"

msgid "Optional EDNS Client Subnet (IP or CIDR), for example 203.0.113.0/24. Leave empty to omit."
msgstr "可选的 EDNS 客户端子网（IP 或 CIDR），例如 203.0.113.0/24。留空则不生成。"

